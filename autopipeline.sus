
extern module primitive_autopipeline #(int C_DATA_WIDTH) {
    clock clk
    input bool[C_DATA_WIDTH] din'0
    // (* autopipeline_group="fwd",autopipeline_limit=12 *)
    output bool[C_DATA_WIDTH] dout'12
}

module data_autopipeline #(T) {
    primitive_autopipeline#(C_DATA_WIDTH: sizeof#(T)) auto_pipeline

    input T din'0
    auto_pipeline.din = ToBits(din)
    // (* autopipeline_group="fwd",autopipeline_limit=12 *)
    output T dout'12 = FromBits(auto_pipeline.dout)
}

module action_autopipeline #(T) {
    primitive_autopipeline#(C_DATA_WIDTH: sizeof#(T) + 1) auto_pipeline

    action din'0: T in_data'0 {
        auto_pipeline.din[0] = true
        auto_pipeline.din[1:] = ToBits(in_data)
    } else {
        auto_pipeline.din[0] = false
    }
    trigger dout'12: T out_data'12
    when auto_pipeline.dout[0] {
        dout(FromBits(auto_pipeline.dout[1:]))
    }
}
