
extern module primitive_pipeline #(int WIDTH, int DEPTH) {
    clock clk
    input bool[WIDTH] din'0
    output bool[WIDTH] dout'DEPTH
}

extern module primitive_pipeline_to_slr_crossing #(int WIDTH, int DEPTH) {
    clock clk
    input bool[WIDTH] din'0
    output bool[WIDTH] dout_laguna'DEPTH
}

extern module primitive_pipeline_from_slr_crossing #(int WIDTH, int DEPTH) {
    clock clk
    input bool[WIDTH] din_laguna'0
    output bool[WIDTH] dout'DEPTH
}

extern module primitive_pipeline_slr_crossing_to_slr_crossing #(int WIDTH, int DEPTH) {
    clock clk
    input bool[WIDTH] din_laguna'0
    output bool[WIDTH] dout_laguna'DEPTH
}

module data_pipeline #(T, int DEPTH) {
    primitive_pipeline#(WIDTH: sizeof#(T), DEPTH) pipeline_regs

    input T din'0
    pipeline_regs.din = ToBits(din)
    output T dout'DEPTH = FromBits(pipeline_regs.dout)
}

module action_pipeline #(T, int DEPTH) {
    primitive_pipeline#(WIDTH: sizeof#(T) + 1, DEPTH) pipeline_regs

    action din'0: T in_data'0 {
        pipeline_regs.din[0] = true
        pipeline_regs.din[1:] = ToBits(in_data)
    } else {
        pipeline_regs.din[0] = false
    }
    trigger dout'DEPTH: T out_data'DEPTH
    when pipeline_regs.dout[0] {
        dout(FromBits(pipeline_regs.dout[1:]))
    }
}


module data_pipeline_cross_slr #(T, int FROM_DEPTH, int TO_DEPTH) {
    primitive_pipeline_to_slr_crossing#(WIDTH: sizeof#(T), DEPTH: FROM_DEPTH) from_slr
    primitive_pipeline_from_slr_crossing#(WIDTH: sizeof#(T), DEPTH: TO_DEPTH) to_slr

    input T din'0
    from_slr.din = ToBits(din)
    to_slr.din_laguna = from_slr.dout_laguna
    // (* pipeline_group="fwd",pipeline_limit=12 *)
    output T dout'FROM_DEPTH+TO_DEPTH = FromBits(to_slr.dout)
}

module action_pipeline_cross_slr #(T, int FROM_DEPTH, int TO_DEPTH) {
    primitive_pipeline_to_slr_crossing#(WIDTH: sizeof#(T)+1, DEPTH: FROM_DEPTH) from_slr
    primitive_pipeline_from_slr_crossing#(WIDTH: sizeof#(T)+1, DEPTH: TO_DEPTH) to_slr

    action din'0: T in_data'0 {
        from_slr.din[0] = true
        from_slr.din[1:] = ToBits(in_data)
    } else {
        from_slr.din[0] = false
    }
    to_slr.din_laguna = from_slr.dout_laguna
    trigger dout'FROM_DEPTH+TO_DEPTH: T out_data'FROM_DEPTH+TO_DEPTH
    when to_slr.dout[0] {
        dout(FromBits(to_slr.dout[1:]))
    }
}


module data_pipeline_cross_slr_twice #(T, int FROM_DEPTH, int MIDDLE_DEPTH, int TO_DEPTH) {
    primitive_pipeline_to_slr_crossing#(WIDTH: sizeof#(T), DEPTH: FROM_DEPTH) from_slr
    primitive_pipeline_slr_crossing_to_slr_crossing#(WIDTH: sizeof#(T), DEPTH: MIDDLE_DEPTH) middle_slr
    primitive_pipeline_from_slr_crossing#(WIDTH: sizeof#(T), DEPTH: TO_DEPTH) to_slr

    input T din'0
    from_slr.din = ToBits(din)
    middle_slr.din_laguna = from_slr.dout_laguna
    to_slr.din_laguna = middle_slr.dout_laguna
    // (* pipeline_group="fwd",pipeline_limit=12 *)
    output T dout'FROM_DEPTH+MIDDLE_DEPTH+TO_DEPTH = FromBits(to_slr.dout)
}

module action_pipeline_cross_slr_twice #(T, int FROM_DEPTH, int MIDDLE_DEPTH, int TO_DEPTH) {
    primitive_pipeline_to_slr_crossing#(WIDTH: sizeof#(T)+1, DEPTH: FROM_DEPTH) from_slr
    primitive_pipeline_slr_crossing_to_slr_crossing#(WIDTH: sizeof#(T)+1, DEPTH: MIDDLE_DEPTH) middle_slr
    primitive_pipeline_from_slr_crossing#(WIDTH: sizeof#(T)+1, DEPTH: TO_DEPTH) to_slr

    action din'0: T in_data'0 {
        from_slr.din[0] = true
        from_slr.din[1:] = ToBits(in_data)
    } else {
        from_slr.din[0] = false
    }
    middle_slr.din_laguna = from_slr.dout_laguna
    to_slr.din_laguna = middle_slr.dout_laguna
    trigger dout'FROM_DEPTH+MIDDLE_DEPTH+TO_DEPTH: T out_data'FROM_DEPTH+MIDDLE_DEPTH+TO_DEPTH
    when to_slr.dout[0] {
        dout(FromBits(to_slr.dout[1:]))
    }
}


extern module LUTRAM_FWFT #(int WIDTH, int DEPTH, int MAY_PUSH_LATENCY) {
    domain push_dom
    output bool may_push'-MAY_PUSH_LATENCY
    action push'0 : bool[WIDTH] push_data'0 {}
    
    domain pop_dom
    trigger pop_available'0 : bool[WIDTH] pop_data'0 {
        action pop'0 {}
    }

    domain reset
    action rst'0 {}
}
