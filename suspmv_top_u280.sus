
module SUSpMV_SLR#(int LEFT_UNITS, int RIGHT_UNITS, int HBM_MAY_PUSH_LATENCY) {
    gen int NUM_UNITS = LEFT_UNITS + RIGHT_UNITS

    SUSpMV_Cluster#(NUM_UNITS: LEFT_UNITS, HBM_MAY_PUSH_LATENCY) left_half
    SUSpMV_Cluster#(NUM_UNITS: RIGHT_UNITS, HBM_MAY_PUSH_LATENCY) right_half

    domain hbm_data
    output bool[NUM_UNITS] may_pushes'-HBM_MAY_PUSH_LATENCY
    may_pushes[:LEFT_UNITS] = left_half.may_pushes
    may_pushes[LEFT_UNITS:] = right_half.may_pushes
    input bool[NUM_UNITS] hbm_valids'0
    left_half.hbm_valids = hbm_valids[:LEFT_UNITS]
    right_half.hbm_valids = hbm_valids[LEFT_UNITS:]
    input bool[256][NUM_UNITS] hbm_datas'0
    left_half.hbm_datas = hbm_datas[:LEFT_UNITS]
    right_half.hbm_datas = hbm_datas[LEFT_UNITS:]

    domain x_data_dom
    Tuple2 pack_x_value_cross
    action_pipeline#(DEPTH: 4) x_value_cross_right
    action_pipeline#(DEPTH: 4) x_value_cross_left
    action push_x_data'0 : float[16] x_data_in'0, bool last_x_data_in'0 {
        x_value_cross_right.din(pack_x_value_cross.pack(x_data_in, last_x_data_in))
        right_half.push_x_data(x_data_in, last_x_data_in)
    }
    when x_value_cross_right.dout : bool[] packed {
        x_value_cross_left.din(packed)
    }
    when x_value_cross_left.dout : bool[] packed {
        float[16] x_data_in, bool last_x_data_in = pack_x_value_cross.unpack(packed)
        left_half.push_x_data(x_data_in, last_x_data_in)
    }
    
    domain x_data_releases
    output bool[NUM_UNITS] x_releases
    x_releases[:LEFT_UNITS] = left_half.x_releases
    x_releases[LEFT_UNITS:] = right_half.x_releases

    domain y_data_out
    input bool may_y_valid
    data_pipeline#(DEPTH: 4) may_y_valid_cross_right
    data_pipeline#(DEPTH: 4) may_y_valid_cross_left
    may_y_valid_cross_right.din = may_y_valid
    may_y_valid_cross_left.din = may_y_valid_cross_right.dout
    right_half.may_y_valid = may_y_valid
    left_half.may_y_valid = may_y_valid_cross_left.dout
    trigger y_valid: float[16] y_values_out, int#(FROM: 0, TO: 17) num_y_values_out, bool is_last_y_out
    when right_half.y_valid : float[16] y_values_out, int#(FROM: 0, TO: 17) num_y_values_out, bool is_last_y_out {
        y_valid(y_values_out, num_y_values_out, is_last_y_out)
    }
    Tuple3 pack_y_value_cross
    action_pipeline#(DEPTH: 4) y_value_cross_left
    action_pipeline#(DEPTH: 4) y_value_cross_right
    when left_half.y_valid : float[16] y_values_out, int#(FROM: 0, TO: 17) num_y_values_out, bool is_last_y_out {
        y_value_cross_left.din(pack_y_value_cross.pack(y_values_out, num_y_values_out, is_last_y_out))
    }
    when y_value_cross_left.dout : bool[] packed {
        y_value_cross_right.din(packed)
    }
    when y_value_cross_right.dout : bool[] packed {
        float[16] y_values_out, int#(FROM: 0, TO: 17) num_y_values_out, bool is_last_y_out = pack_y_value_cross.unpack(packed)
        y_valid(y_values_out, num_y_values_out, is_last_y_out)
    }

    domain y_starts
    input bool[NUM_UNITS] start_y_bursts
    left_half.start_y_bursts = start_y_bursts[:LEFT_UNITS]
    right_half.start_y_bursts = start_y_bursts[LEFT_UNITS:]

    domain reset
    action_pipeline#(DEPTH: 4) rst_pipeline_cross_right
    action_pipeline#(DEPTH: 4) rst_pipeline_cross_left
    action rst {
        right_half.rst()
        rst_pipeline_cross_right.din([])
    }
    when rst_pipeline_cross_right.dout : bool[0] _out_data {
        rst_pipeline_cross_left.din([])
    }
    when rst_pipeline_cross_left.dout : bool[0] _out_data {
        left_half.rst()
    }
}

module SUSpMV_Full {
    clock aclk
    input bool aresetn

    gen int PARALLEL_X_READ = 16

    gen int CTRL_AXI_WIDTH = 64
    gen int CTRL_ADDR_WIDTH = 12

    gen int MEM_ADDR_WIDTH = 64
    gen int DDR_AXI_READ_WIDTH = PARALLEL_X_READ * 4 * 8
    gen int DDR_AXI_WRITE_WIDTH = 512
    gen int HBM_AXI_WIDTH = 256

    gen int UNITS_SLR0_LEFT = 7
    gen int UNITS_SLR0_RIGHT = 0
    gen int UNITS_SLR1_LEFT = 8
    gen int UNITS_SLR1_RIGHT = 3
    gen int UNITS_SLR2_LEFT = 8
    gen int UNITS_SLR2_RIGHT = 6

    gen int UNITS_SLR0 = UNITS_SLR0_LEFT + UNITS_SLR0_RIGHT
    gen int UNITS_SLR1 = UNITS_SLR1_LEFT + UNITS_SLR1_RIGHT
    gen int UNITS_SLR2 = UNITS_SLR2_LEFT + UNITS_SLR2_RIGHT

    //gen int NUM_HBMS = UNITS_SLR0 + UNITS_SLR1 + UNITS_SLR2
    gen int NUM_UNITS = UNITS_SLR0 + UNITS_SLR1 + UNITS_SLR2
    gen int NUM_HBMS = 32

    // Now shuffle the HBM indices, so the HBM lines go straight up instead of criss-cross
    gen int[NUM_UNITS] HBM_IDX_PER_UNIT = [
        // SLR0 LEFT
        8,9,10,11,12,13,14,
        // SLR0 RIGHT
        // none

        // SLR1 LEFT
        0,1,2,3,4,5,6,7,
        // SLR1 RIGHT
        23,24,25,

        // SLR2 LEFT
        15,16,17,18,19,20,21,22,
        // SLR2 RIGHT
        26,27,28,29,30,31
    ]
    
    //xrt_ctrl_slave #(NUM_INPUT_REGS: 6 + 4 * NUM_HBMS, NUM_OUTPUT_REGS: 0, ADDR_WIDTH: CTRL_ADDR_WIDTH, AXI_WIDTH: CTRL_AXI_WIDTH) ctrl
    tapasco_ctrl_slave_noregs #(NUM_INPUT_REGS: 4 + 2 * NUM_HBMS, ADDR_WIDTH: CTRL_ADDR_WIDTH, AXI_WIDTH: CTRL_AXI_WIDTH) ctrl

    // ============================= //
    //  AXI4-Lite Control interface  //
    // ============================= //
    domain axi_control
    input  int#(FROM: 0, TO: 1 << CTRL_ADDR_WIDTH)    s_axi_control_awaddr
    input  bool                                       s_axi_control_awvalid
    output bool                                       s_axi_control_awready = ctrl.awready
    input bool[3]                                     s_axi_control_awprot
    input  bool[CTRL_AXI_WIDTH]                       s_axi_control_wdata
    input  bool[CTRL_AXI_WIDTH / 8]                   s_axi_control_wstrb
    input  bool                                       s_axi_control_wvalid
    output bool                                       s_axi_control_wready  = ctrl.wready
    output bool[2]                                    s_axi_control_bresp   = ctrl.bresp
    output bool                                       s_axi_control_bvalid  = ctrl.bvalid
    input  bool                                       s_axi_control_bready
    input  int#(FROM: 0, TO: 1 << CTRL_ADDR_WIDTH)    s_axi_control_araddr
    input  bool                                       s_axi_control_arvalid
    output bool                                       s_axi_control_arready = ctrl.arready
    input bool[3]                                     s_axi_control_arprot
    output bool[CTRL_AXI_WIDTH]                       s_axi_control_rdata   = ctrl.rdata
    output bool[2]                                    s_axi_control_rresp   = ctrl.rresp
    output bool                                       s_axi_control_rvalid  = ctrl.rvalid
    input  bool                                       s_axi_control_rready
    ctrl.awaddr  =                                    s_axi_control_awaddr
    ctrl.awvalid =                                    s_axi_control_awvalid
    ctrl.awprot  =                                    s_axi_control_awprot
    ctrl.wdata   =                                    s_axi_control_wdata
    ctrl.wstrb   =                                    s_axi_control_wstrb
    ctrl.wvalid  =                                    s_axi_control_wvalid
    ctrl.bready  =                                    s_axi_control_bready
    ctrl.araddr  =                                    s_axi_control_araddr
    ctrl.arvalid =                                    s_axi_control_arvalid
    ctrl.arprot  =                                    s_axi_control_arprot
    ctrl.rready  =                                    s_axi_control_rready
    output bool intr = ctrl.intr

    // ======================================================== //
    //  AXI4-Full DDR interface for X vector & result Y vector  //
    // ======================================================== //
    XDataLoader#(NUM_KERNELS: NUM_UNITS) x_vector_reader
    YVectorWriter#(NUM_KERNELS: NUM_UNITS) y_result_writer

    domain ddr_write
    output bool                                    maxi_ddr00_awvalid = y_result_writer.awvalid
    input  bool                                    maxi_ddr00_awready
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)  maxi_ddr00_awaddr = y_result_writer.awaddr
    output int#(FROM: 0, TO: 256)                  maxi_ddr00_awlen = y_result_writer.awlen
    output int#(FROM: 0, TO: 8)                    maxi_ddr00_awsize  = y_result_writer.awsize
    output bool[2]                                 maxi_ddr00_awburst = y_result_writer.awburst
    output bool[3]                                 maxi_ddr00_awprot = y_result_writer.awprot
    output bool[4]                                 maxi_ddr00_awcache = y_result_writer.awcache
    output int#(FROM: 0, TO: 16)                   maxi_ddr00_awqos = y_result_writer.awqos
    output bool                                    maxi_ddr00_awlock = y_result_writer.awlock
    output int#(FROM: 0, TO: 16)                   maxi_ddr00_awregion = y_result_writer.awregion
    output bool                                    maxi_ddr00_wvalid = y_result_writer.wvalid
    input  bool                                    maxi_ddr00_wready
    output bool[DDR_AXI_WRITE_WIDTH]               maxi_ddr00_wdata = y_result_writer.wdata
    output bool[DDR_AXI_WRITE_WIDTH / 8]           maxi_ddr00_wstrb = y_result_writer.wstrb
    output bool                                    maxi_ddr00_wlast = y_result_writer.wlast
    input  bool                                    maxi_ddr00_bvalid
    output bool                                    maxi_ddr00_bready = y_result_writer.bready
    input  bool[2]                                 maxi_ddr00_bresp
    y_result_writer.awready =                      maxi_ddr00_awready
    y_result_writer.wready =                       maxi_ddr00_wready
    y_result_writer.bvalid =                       maxi_ddr00_bvalid
    y_result_writer.bresp =                        maxi_ddr00_bresp
    
    domain ddr_read
    output bool                                    maxi_ddr00_arvalid'0 = x_vector_reader.arvalid
    input  bool                                    maxi_ddr00_arready
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)  maxi_ddr00_araddr = x_vector_reader.araddr
    output int#(FROM: 0, TO: 256)                  maxi_ddr00_arlen = x_vector_reader.arlen
    output int#(FROM: 0, TO: 8)                    maxi_ddr00_arsize  = x_vector_reader.arsize
    output bool[2]                                 maxi_ddr00_arburst = x_vector_reader.arburst
    output bool[3]                                 maxi_ddr00_arprot = x_vector_reader.arprot
    output bool[4]                                 maxi_ddr00_arcache = x_vector_reader.arcache
    output int#(FROM: 0, TO: 16)                   maxi_ddr00_arqos = x_vector_reader.arqos
    output bool                                    maxi_ddr00_arlock = x_vector_reader.arlock
    output int#(FROM: 0, TO: 16)                   maxi_ddr00_arregion = x_vector_reader.arregion
    input  bool                                    maxi_ddr00_rvalid
    output bool                                    maxi_ddr00_rready = x_vector_reader.rready
    input  bool[DDR_AXI_READ_WIDTH]                maxi_ddr00_rdata
    input  bool[2]                                 maxi_ddr00_rresp
    input  bool                                    maxi_ddr00_rlast
    x_vector_reader.arready =                      maxi_ddr00_arready
    x_vector_reader.rvalid =                       maxi_ddr00_rvalid
    x_vector_reader.rdata =                        maxi_ddr00_rdata
    x_vector_reader.rresp =                        maxi_ddr00_rresp
    x_vector_reader.rlast =                        maxi_ddr00_rlast


    // ========= //
    //  Kernels  //
    // ========= //
    SUSpMV_SLR#(LEFT_UNITS: UNITS_SLR0_LEFT, RIGHT_UNITS: UNITS_SLR0_RIGHT) suspmv_slr0
    SUSpMV_SLR#(LEFT_UNITS: UNITS_SLR1_LEFT, RIGHT_UNITS: UNITS_SLR1_RIGHT) suspmv_slr1
    SUSpMV_SLR#(LEFT_UNITS: UNITS_SLR2_LEFT, RIGHT_UNITS: UNITS_SLR2_RIGHT) suspmv_slr2

    // =========== //
    //  Addresses  //
    // =========== //

    // Pipeline regs to get from SLR0 to SLR1
    Tuple4 pack_ddr_settings
    action_pipeline#(DEPTH: 8) pipe_ctrl_to_ddr
    
    CycleCounter#(TO: 1 << 64) cycle_counter
    
    // SUS TODO: Local Actions (https://github.com/pc2/sus-compiler/issues/198)
    
    state bool[CTRL_AXI_WIDTH][4] ddr_args

    LineBusDistributor#(AXI_WIDTH: CTRL_AXI_WIDTH, NUM_OUTPUTS: 16, IDX_TO: 256) hbm_info_distributor_left
    LineBusDistributor#(AXI_WIDTH: CTRL_AXI_WIDTH, NUM_OUTPUTS: 16, IDX_TO: 256) hbm_info_distributor_right
    Tuple2 pack_hbm_ctrl
    action_pipeline#(DEPTH: 6) pipe_ctrl_to_hbm
    Tuple2 pack_hbm_ctrl_left
    action_pipeline#(DEPTH: 2) pipe_ctrl_to_hbm_left
    Tuple2 pack_hbm_ctrl_right
    action_pipeline#(DEPTH: 2) pipe_ctrl_to_hbm_right

    when ctrl.set_reg : int reg_idx, bool[CTRL_AXI_WIDTH] data {
        when reg_idx >= 2 & reg_idx < 6 {
            ddr_args[IntNarrow#(FROM: 2, TO: 6)(reg_idx) - 2] = data
        }
        pipe_ctrl_to_hbm.din(pack_hbm_ctrl.pack(reg_idx, data))
    }
    when pipe_ctrl_to_hbm.dout : bool[] packed {
        int reg_idx, bool[CTRL_AXI_WIDTH] data = pack_hbm_ctrl.unpack(packed)
        pipe_ctrl_to_hbm_left.din(pack_hbm_ctrl_left.pack(reg_idx, data))
        pipe_ctrl_to_hbm_right.din(pack_hbm_ctrl_right.pack(reg_idx, data))
    }
    when pipe_ctrl_to_hbm_left.dout : bool[] packed {
        int reg_idx, bool[CTRL_AXI_WIDTH] data = pack_hbm_ctrl_left.unpack(packed)
        hbm_info_distributor_left.write(reg_idx, data)
    }
    when pipe_ctrl_to_hbm_right.dout : bool[] packed {
        int reg_idx, bool[CTRL_AXI_WIDTH] data = pack_hbm_ctrl_right.unpack(packed)
        hbm_info_distributor_right.write(reg_idx, data)
    }
    bool[NUM_HBMS] hbm_ctrl_valid
    int#(FROM: 0, TO: 256)[NUM_HBMS] hbm_ctrl_idx
    bool[CTRL_AXI_WIDTH][NUM_HBMS] hbm_ctrl_data
    for int I in 0..16 {
        hbm_ctrl_valid[15-I] = hbm_info_distributor_left.valids[I]
        hbm_ctrl_valid[16+I] = hbm_info_distributor_right.valids[I]
        hbm_ctrl_idx[15-I] = hbm_info_distributor_left.idxes[I]
        hbm_ctrl_idx[16+I] = hbm_info_distributor_right.idxes[I]
        hbm_ctrl_data[15-I] = hbm_info_distributor_left.datas[I]
        hbm_ctrl_data[16+I] = hbm_info_distributor_right.datas[I]
    }
    
    gen int[NUM_HBMS] HBM_ADDR_REGS
    gen int[NUM_HBMS] HBM_COUNT_REGS

    for int I in 0..NUM_HBMS {
        HBM_ADDR_REGS[I] = I * 2 + 4 + 2
        HBM_COUNT_REGS[I] = I * 2 + 5 + 2
    }

    when ctrl.start {
        int x_vector_addr = BitsToUInt(ddr_args[0])
        int y_vector_addr = BitsToUInt(ddr_args[1])
        int num_x_pages = BitsToUInt(ddr_args[2]) mod 1 << 32
        int num_y_repetitions = BitsToUInt(ddr_args[3]) mod 1 << 32
        pipe_ctrl_to_ddr.din(pack_ddr_settings.pack(x_vector_addr, y_vector_addr, num_x_pages, num_y_repetitions))

        cycle_counter.start()
    }
    when pipe_ctrl_to_ddr.dout : bool[] packed_ddr1_settings {
        int x_vector_addr,
        int y_vector_addr,
        int num_x_pages,
        int num_y_repetitions = pack_ddr_settings.unpack(packed_ddr1_settings)

        x_vector_reader.start_loading(x_vector_addr, num_x_pages, num_y_repetitions)
        y_result_writer.submit_y_vector_addr(y_vector_addr, num_y_repetitions)
    }

    bool[256][NUM_HBMS] hbm_weight_datas_hbm
    bool[NUM_HBMS] hbm_weight_valids_hbm
    bool[NUM_HBMS] hbm_may_pushes_hbm

    bool[NUM_UNITS] x_page_releases_unit
    bool[NUM_UNITS] y_unit_may_starts_unit
    
    bool[256][NUM_UNITS] hbm_weight_datas_unit
    bool[NUM_UNITS] hbm_weight_valids_unit
    bool[NUM_UNITS] hbm_may_pushes_unit

    for int UNIT_I in 0..NUM_UNITS {
        gen int HBM_I = HBM_IDX_PER_UNIT[UNIT_I]
        x_vector_reader.x_page_releases[HBM_I] = x_page_releases_unit[UNIT_I]
        y_unit_may_starts_unit[UNIT_I] = y_result_writer.unit_may_starts[HBM_I]
        hbm_may_pushes_hbm[HBM_I] = hbm_may_pushes_unit[UNIT_I]
        hbm_weight_datas_unit[UNIT_I] = hbm_weight_datas_hbm[HBM_I]
        hbm_weight_valids_unit[UNIT_I] = hbm_weight_valids_hbm[HBM_I]
    }

    when y_result_writer.write_has_been_committed {
        int num_cycles = cycle_counter.finish()
        ctrl.finish(UIntToBits(num_cycles))
    }

    // Shared data for SLRs
    Tuple2 pack_x_vector_info_slr1
    Tuple2 pack_x_vector_info_slr2
    action_pipeline_cross_slr#(FROM_DEPTH: 8, TO_DEPTH: 8) pipe_x_vector_info_slr0_to_slr1
    action_pipeline_cross_slr#(FROM_DEPTH: 8, TO_DEPTH: 8) pipe_x_vector_info_slr1_to_slr2
    data_pipeline#(DEPTH: 8) pipe_x_page_releases_slr0_to_slr0
    data_pipeline_cross_slr#(FROM_DEPTH: 8, TO_DEPTH: 8) pipe_x_page_releases_slr1_to_slr0
    data_pipeline_cross_slr_twice#(FROM_DEPTH: 8, MIDDLE_DEPTH: 8, TO_DEPTH: 8) pipe_x_page_releases_slr2_to_slr0

    pipe_x_page_releases_slr0_to_slr0.din = suspmv_slr0.x_releases
    pipe_x_page_releases_slr1_to_slr0.din = suspmv_slr1.x_releases
    pipe_x_page_releases_slr2_to_slr0.din = suspmv_slr2.x_releases
    x_page_releases_unit[0:UNITS_SLR0] = pipe_x_page_releases_slr0_to_slr0.dout
    x_page_releases_unit[UNITS_SLR0+:UNITS_SLR1] = pipe_x_page_releases_slr1_to_slr0.dout
    x_page_releases_unit[UNITS_SLR0+UNITS_SLR1+:UNITS_SLR2] = pipe_x_page_releases_slr2_to_slr0.dout

    when x_vector_reader.x_valid : float[16] x_values, bool x_last {
        pipe_x_vector_info_slr0_to_slr1.din(pack_x_vector_info_slr1.pack(x_values, x_last))
        suspmv_slr0.push_x_data(x_values, x_last)
    }
    when pipe_x_vector_info_slr0_to_slr1.dout : bool[] packed {
        float[16] x_values, bool x_last = pack_x_vector_info_slr1.unpack(packed)
        pipe_x_vector_info_slr1_to_slr2.din(pack_x_vector_info_slr2.pack(x_values, x_last))
        suspmv_slr1.push_x_data(x_values, x_last)
    }

    when pipe_x_vector_info_slr1_to_slr2.dout : bool[] packed {
        float[16] x_values, bool x_last = pack_x_vector_info_slr2.unpack(packed)
        suspmv_slr2.push_x_data(x_values, x_last)
    }

    data_pipeline#(DEPTH: 6) pipe_start_y_bursts_slr0_to_slr0
    data_pipeline_cross_slr#(FROM_DEPTH: 6, TO_DEPTH: 6) pipe_start_y_bursts_slr0_to_slr1
    data_pipeline_cross_slr_twice#(FROM_DEPTH: 6, MIDDLE_DEPTH: 8, TO_DEPTH: 6) pipe_start_y_bursts_slr0_to_slr2
    data_pipeline#(DEPTH: 6) pipe_may_y_valid_slr0_to_slr0
    data_pipeline_cross_slr#(FROM_DEPTH: 6, TO_DEPTH: 6) pipe_may_y_valid_slr0_to_slr1
    data_pipeline_cross_slr_twice#(FROM_DEPTH: 6, MIDDLE_DEPTH: 8, TO_DEPTH: 6) pipe_may_y_valid_slr0_to_slr2

    pipe_start_y_bursts_slr0_to_slr0.din = y_unit_may_starts_unit[0:UNITS_SLR0]
    suspmv_slr0.start_y_bursts = pipe_start_y_bursts_slr0_to_slr0.dout
    pipe_start_y_bursts_slr0_to_slr1.din = y_unit_may_starts_unit[UNITS_SLR0+:UNITS_SLR1]
    suspmv_slr1.start_y_bursts = pipe_start_y_bursts_slr0_to_slr1.dout
    pipe_start_y_bursts_slr0_to_slr2.din = y_unit_may_starts_unit[UNITS_SLR0+UNITS_SLR1+:UNITS_SLR2]
    suspmv_slr2.start_y_bursts = pipe_start_y_bursts_slr0_to_slr2.dout

    pipe_may_y_valid_slr0_to_slr0.din = y_result_writer.may_write
    suspmv_slr0.may_y_valid = pipe_may_y_valid_slr0_to_slr0.dout
    pipe_may_y_valid_slr0_to_slr1.din = y_result_writer.may_write
    suspmv_slr1.may_y_valid = pipe_may_y_valid_slr0_to_slr1.dout
    pipe_may_y_valid_slr0_to_slr2.din = y_result_writer.may_write
    suspmv_slr2.may_y_valid = pipe_may_y_valid_slr0_to_slr2.dout

    // To cross SLR1 -> SLR2
    Tuple3 pack_y_valid_slr1
    action_pipeline_cross_slr#(FROM_DEPTH: 4, TO_DEPTH: 4) pipe_y_valid_to_slr1_to_slr0
    Tuple3 pack_y_valid_slr2
    action_pipeline_cross_slr#(FROM_DEPTH: 4, TO_DEPTH: 4) pipe_y_valid_to_slr2_to_slr1

    when suspmv_slr2.y_valid : float[16] y_values_slr2, int#(FROM: 0, TO: 17) num_y_values_slr2, bool is_last_y_slr2 {
        pipe_y_valid_to_slr2_to_slr1.din(pack_y_valid_slr2.pack(y_values_slr2, num_y_values_slr2, is_last_y_slr2))
    }

    when pipe_y_valid_to_slr2_to_slr1.dout : bool[] packed_y_slr1 {
        pipe_y_valid_to_slr1_to_slr0.din(packed_y_slr1)
    }
    when suspmv_slr1.y_valid : float[16] y_values_slr1, int#(FROM: 0, TO: 17) num_y_values_slr1, bool is_last_y_slr1 {
        pipe_y_valid_to_slr1_to_slr0.din(pack_y_valid_slr1.pack(y_values_slr1, num_y_values_slr1, is_last_y_slr1))
    }
    when pipe_y_valid_to_slr1_to_slr0.dout : bool[] packed_y_slr0 {
        float[16] y_values_out, int#(FROM: 0, TO: 17) num_y_values_out, bool is_last_y_out = pack_y_valid_slr2.unpack(packed_y_slr0)
        y_result_writer.write(y_values_out, num_y_values_out, is_last_y_out)
    }
    when suspmv_slr0.y_valid : float[16] y_values_slr0, int#(FROM: 0, TO: 17) num_y_values_slr0, bool is_last_y_slr0 {
        y_result_writer.write(y_values_slr0, num_y_values_slr0, is_last_y_slr0)
    }

    // =================== //
    // Pipe HBM Weights up //
    // =================== //
    
    data_pipeline#(DEPTH: 6) pipe_hbm_may_push_slr0_to_slr0
    pipe_hbm_may_push_slr0_to_slr0.din = suspmv_slr0.may_pushes
    data_pipeline#(DEPTH: 6) pipe_hbm_weights_slr0_to_slr0
    hbm_may_pushes_unit[0:UNITS_SLR0] = pipe_hbm_may_push_slr0_to_slr0.dout
    Tuple2 pack_hbm_weights_slr0
    pipe_hbm_weights_slr0_to_slr0.din = pack_hbm_weights_slr0.pack(hbm_weight_valids_unit[0:UNITS_SLR0], hbm_weight_datas_unit[0:UNITS_SLR0])
    suspmv_slr0.hbm_valids, suspmv_slr0.hbm_datas = pack_hbm_weights_slr0.unpack(pipe_hbm_weights_slr0_to_slr0.dout)

    data_pipeline_cross_slr#(FROM_DEPTH: 4, TO_DEPTH: 6) pipe_hbm_may_push_slr1_to_slr0
    pipe_hbm_may_push_slr1_to_slr0.din = suspmv_slr1.may_pushes
    data_pipeline_cross_slr#(FROM_DEPTH: 6, TO_DEPTH: 4) pipe_hbm_weights_slr0_to_slr1
    hbm_may_pushes_unit[UNITS_SLR0+:UNITS_SLR1] = pipe_hbm_may_push_slr1_to_slr0.dout
    Tuple2 pack_hbm_weights_slr1
    pipe_hbm_weights_slr0_to_slr1.din = pack_hbm_weights_slr1.pack(hbm_weight_valids_unit[UNITS_SLR0+:UNITS_SLR1], hbm_weight_datas_unit[UNITS_SLR0+:UNITS_SLR1])
    suspmv_slr1.hbm_valids, suspmv_slr1.hbm_datas = pack_hbm_weights_slr1.unpack(pipe_hbm_weights_slr0_to_slr1.dout)

    data_pipeline_cross_slr_twice#(FROM_DEPTH: 4, MIDDLE_DEPTH: 8, TO_DEPTH: 6) pipe_hbm_may_push_slr2_to_slr0
    pipe_hbm_may_push_slr2_to_slr0.din = suspmv_slr2.may_pushes
    data_pipeline_cross_slr_twice#(FROM_DEPTH: 6, MIDDLE_DEPTH: 8, TO_DEPTH: 4) pipe_hbm_weights_slr0_to_slr2
    hbm_may_pushes_unit[UNITS_SLR0+UNITS_SLR1+:UNITS_SLR2] = pipe_hbm_may_push_slr2_to_slr0.dout
    Tuple2 pack_hbm_weights_slr2
    pipe_hbm_weights_slr0_to_slr2.din = pack_hbm_weights_slr2.pack(hbm_weight_valids_unit[UNITS_SLR0+UNITS_SLR1+:UNITS_SLR2], hbm_weight_datas_unit[UNITS_SLR0+UNITS_SLR1+:UNITS_SLR2])
    suspmv_slr2.hbm_valids, suspmv_slr2.hbm_datas = pack_hbm_weights_slr2.unpack(pipe_hbm_weights_slr0_to_slr2.dout)

    // ====== //
    // Resets //
    // ====== //

    data_pipeline#(DEPTH: 8) pipe_rst_slr0
    WideFanout#(SIZE: NUM_HBMS, DEPTH: 8) hbm_rst_fanout
    data_pipeline_cross_slr#(FROM_DEPTH: 8, TO_DEPTH: 8) pipe_rst_slr0_to_slr1
    data_pipeline_cross_slr_twice#(FROM_DEPTH: 8, MIDDLE_DEPTH: 8, TO_DEPTH: 8) pipe_rst_slr0_to_slr2

    ResetLengthener#(MIN_RESET_CYCLES: 30) rst_lengthener
    when !aresetn {
        rst_lengthener.rst_in()
    }
    bool lengthened_rst = false
    when rst_lengthener.rst_out {
        lengthened_rst = true
    }
    pipe_rst_slr0.din = lengthened_rst
    hbm_rst_fanout.din = lengthened_rst
    pipe_rst_slr0_to_slr1.din = lengthened_rst
    pipe_rst_slr0_to_slr2.din = lengthened_rst

    when pipe_rst_slr0.dout {
        ctrl.rst()
        x_vector_reader.rst()
        y_result_writer.rst()

        suspmv_slr0.rst()
    }

    when pipe_rst_slr0_to_slr1.dout {
        suspmv_slr1.rst()
    }

    when pipe_rst_slr0_to_slr2.dout {
        suspmv_slr2.rst()
    }


