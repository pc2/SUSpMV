
module MultiAccumulate {
    gen int PARALLELISM = 6

    fp64_reduce_sum accumulator

    domain default
    action valid_set : double[PARALLELISM] values, bool[PARALLELISM] is_lasts -> double[PARALLELISM] partial_sums {
        split double[PARALLELISM] adder_left_inputs
        split double[PARALLELISM] adder_outputs

        for int I in 0..6 {
            when is_lasts[I] {
                adder_left_inputs[I] = 0.0d
            } else {
                adder_left_inputs[I] = adder_outputs[I]
            }
        }

        adder_outputs[0] = values[0]
        for int I in 1..6 {
            adder_outputs[I] = fp64_add(adder_left_inputs[I-1], values[I])
        }

        double[PARALLELISM] accumulator_input_selector
        for int I in 0..6 {
            accumulator_input_selector[I] = adder_outputs[I]
        }

        FirstSetBit find_first_bit
        find_first_bit.find(is_lasts)
        when find_first_bit.is_nonzero : int index {
            accumulator.accumulate(accumulator_input_selector[index])
            double accululated_partial_sum = accumulator.last(adder_left_inputs[PARALLELISM-1])

            for int I in 0..PARALLELISM {
                when index == I {
                    partial_sums[I] = accululated_partial_sum
                } else {
                    partial_sums[I] = adder_outputs[I]
                }
            }
        } else {
            accumulator.accumulate(accumulator_input_selector[PARALLELISM-1])
        }
    }

    domain reset
    action rst {
        accumulator.rst()
    }
}

module YIndexManager {
    gen int PARALELLISM = 6
    gen int Y_TO = 2048 * 16
    gen int Y_DELTA_TO = 256

    state int#(FROM: 0, TO: Y_TO) cur_y_base

    domain main
    action push :
        int#(FROM: 0, TO: Y_DELTA_TO)[PARALELLISM] y_deltas,
        bool is_last_x ->
        int[PARALELLISM] y_indices {
        
        split int[7] total_deltas
        total_deltas[0] = 0
        for int I in 0..6 {
            reg total_deltas[I+1] = total_deltas[I] + y_deltas[I]
        }
        for int I in 0..6 {
            reg y_indices[I] = cur_y_base + total_deltas[I] mod Y_TO
        }
        
        when is_last_x {
            cur_y_base = 0
        } else {
            cur_y_base = cur_y_base + total_deltas[6] mod Y_TO
        }
    }

    domain reset
    action rst {
        cur_y_base = 0
    }
}

module TreeMax#(int SIZE, int FROM, int TO) {
    action TreeMax : int#(FROM, TO)[SIZE] values -> int max {
        if SIZE == 0 {
            max = FROM
        } else if SIZE == 1 {
            max = values[0]
        } else {
            split int[][clog2#(V: SIZE)] inter_maxes

            for int I in 0..SIZE {
                inter_maxes[0] = values
            }
            gen int CUR_SIZE = SIZE
            for int LAYER in 0..clog2#(V: SIZE) {
                gen int NEXT_SIZE = (CUR_SIZE + 1) / 2
                int[CUR_SIZE] cur_maxes = inter_maxes[LAYER]
                int[NEXT_SIZE] next_maxes

                for int I in 0..NEXT_SIZE {
                    if I == CUR_SIZE / 2 {
                        next_maxes[I] = cur_maxes[I * 2]
                    } else {
                        when cur_maxes[I * 2] > cur_maxes[I * 2 + 1] {
                            next_maxes[I] = cur_maxes[I * 2]
                        } else {
                            next_maxes[I] = cur_maxes[I * 2 + 1]
                        }
                    }
                }
                inter_maxes[LAYER+1] = next_maxes
                CUR_SIZE = NEXT_SIZE
            }
            int[1] last = inter_maxes[clog2#(V: SIZE)]
            max = last[0]
        }
    }
}

module TreeMin#(int SIZE, int FROM, int TO) {
    action TreeMin'0 : int#(FROM, TO)[SIZE] values'0 -> int min {
        if SIZE == 0 {
            min = TO-1
        } else if SIZE == 1 {
            min = values[0]
        } else {
            split int[][clog2#(V: SIZE)+1] inter_mins

            for int I in 0..SIZE {
                inter_mins[0] = values
            }
            gen int CUR_SIZE = SIZE
            for int LAYER in 0..clog2#(V: SIZE) {
                gen int NEXT_SIZE = (CUR_SIZE + 1) / 2
                int[CUR_SIZE] cur_mins = inter_mins[LAYER]
                int[NEXT_SIZE] next_mins

                for int I in 0..NEXT_SIZE {
                    if I == CUR_SIZE / 2 {
                        next_mins[I] = cur_mins[I * 2]
                    } else {
                        when cur_mins[I * 2] < cur_mins[I * 2 + 1] {
                            next_mins[I] = cur_mins[I * 2]
                        } else {
                            next_mins[I] = cur_mins[I * 2 + 1]
                        }
                    }
                }
                inter_mins[LAYER+1] = next_mins
                CUR_SIZE = NEXT_SIZE
            }
            int[1] last = inter_mins[clog2#(V: SIZE)]
            min = last[0]
        }
    }
}

module LatencyCut#(T) {
    domain a
    input T din

    domain b
    output T dout = din
}

module ResetLengthener#(int MIN_RESET_CYCLES) {
    state int#(FROM: 0, TO: MIN_RESET_CYCLES) reset_countdown

    domain reset_in
    action rst_in {
        reset_countdown = MIN_RESET_CYCLES - 1
    } else when reset_countdown != 0 {
        reset_countdown = IntNarrow#(FROM: 0, TO: MIN_RESET_CYCLES)(reset_countdown - 1)
    }

    domain reset_out
    // Some pipeline regs so our new reset signal can reach far
    reg reg reg reg reg output bool rst_out = reset_countdown != 0    
}

module JoiningFIFO#(T, int NUM_FIFOS, int DEPTH, int MAY_PUSH_LATENCY) {
    state int#(FROM: 0, TO: DEPTH * 2)[NUM_FIFOS] write_addrs'0
    state int#(FROM: 0, TO: DEPTH * 2) read_addr'0
    
    state bool[sizeof#(T)][DEPTH][NUM_FIFOS] memory

    domain push_side
    output bool[NUM_FIFOS] may_pushes'-MAY_PUSH_LATENCY
    input bool[NUM_FIFOS] pushes'0
    input T[NUM_FIFOS] datas'0

    bool[NUM_FIFOS] internal_may_pushes
    may_pushes = LatencyOffset #(OFFSET: -MAY_PUSH_LATENCY-1)(internal_may_pushes)

    for int I in 0..NUM_FIFOS {
	    int space_remaining = (read_addr mod DEPTH) - (write_addrs[I] mod DEPTH) - 1 mod DEPTH
        reg internal_may_pushes[I] = space_remaining > MAY_PUSH_LATENCY + 1

        when pushes[I] {
            memory[I][write_addrs[I] mod DEPTH] = ToBits(datas[I])
            write_addrs[I] = write_addrs[I] + 1 mod DEPTH * 2
        }
    }

    int#(FROM: 0, TO: DEPTH * 2)[NUM_FIFOS] relative_write_addrs
    bool read_addr_in_second_half = read_addr >= DEPTH
    for int I in 0..NUM_FIFOS {
        when read_addr_in_second_half {
            relative_write_addrs[I] = (write_addrs[I] - DEPTH) mod DEPTH
        } else {
            relative_write_addrs[I] = write_addrs[I]
        }
    }
    /// We don't actually care about the pipelining of minimum_write_addr
    /// because it is monotonically ascending, 
    LatencyCut cut_minimum_write_addr
    reg reg reg reg int pipelined_relative_write_addrs = TreeMin(relative_write_addrs)
    cut_minimum_write_addr.din = pipelined_relative_write_addrs
    int minimum_write_addr = cut_minimum_write_addr.dout


    domain pop_side
    output bool may_pop'0 = (minimum_write_addr mod DEPTH) != (read_addr mod DEPTH)
    action pop'0 : -> T[NUM_FIFOS] pop_data {
        for int I in 0..NUM_FIFOS {
            reg pop_data[I] = FromBits(memory[I][read_addr mod DEPTH])
        }
        read_addr = read_addr + 1 mod DEPTH * 2
    }

    domain reset
    action rst {
        read_addr = 0
        for int I in 0..NUM_FIFOS {
            write_addrs[I] = 0
        }
    }
}

/// Collects and sums up y values. 
/// reset must be held for 4096 cycles to fully reset the Y vector memory
module YCollector {
    gen int NUM_Y_BUFFERS = 2
    //DoubleBuffer#(T: type double, DEPTH: 2048, NUM_BUFFERS: 2) buf
    gen int PARALELLISM = 6
    gen int NUM_BUCKETS = 16
    // The 16 banks are arranged as double buffers. 
    gen int HALF_RAM_DEPTH = 2048
    gen int NUM_Y_INDICES = HALF_RAM_DEPTH * NUM_BUCKETS
    gen int Y_DELTA = 256
    YIndexManager y_index_manager

    state int#(FROM: 0, TO: NUM_Y_BUFFERS) current_front_buffer
    state int#(FROM: 0, TO: NUM_Y_BUFFERS) current_back_buffer

    bool[NUM_BUCKETS] bucket_write = RepeatGen#(T: type bool, V: false, SIZE: NUM_BUCKETS)
    double[NUM_BUCKETS] bucket_write_value
    int[NUM_BUCKETS] bucket_write_index
    int[NUM_BUCKETS] bucket_mux_from

    /// With highest_y and y_ends_fifo, we find how many y values there are in this block. That way, this information doesn't need to be provided by the parent. 
    /// Since there are only 2 y buffers, that's the maximum number of y pages that can be in flight at the same time. the number of y pages in use can only be decreased after pulling from this fifo. 
    RippleFIFO#(DEPTH: NUM_Y_BUFFERS) y_ends_fifo
    bool _ = y_ends_fifo.may_push // We'll never exceed this FIFO, because max 2 y buffers can be in flight anyway. 
    state int highest_y

    domain default
    action push_partial_sums'0 :
        double[PARALELLISM] partial_sums'7,
        int#(FROM: 0, TO: Y_DELTA)[PARALELLISM] y_deltas'0,
        bool end_of_x_block'0,
        bool end_of_y_block'0 {

        int[PARALELLISM] y_indices = y_index_manager.push(y_deltas, end_of_x_block)
        bool[PARALELLISM] valids
        for int I in 0..PARALELLISM {
            reg valids[I] = y_deltas[I] != 0
        }

        int[PARALELLISM] target_buckets
        int[PARALELLISM] target_indices_in_buckets

        for int CHANNEL in 0..PARALELLISM {
            target_buckets[CHANNEL] = y_indices[CHANNEL] mod NUM_BUCKETS
            target_indices_in_buckets[CHANNEL] = y_indices[CHANNEL] / NUM_BUCKETS
        }
        
        for int BUCKET_I in 0..NUM_BUCKETS {
            for int CHANNEL in 0..PARALELLISM {
                reg bool should_write_bucket_pipeline = valids[CHANNEL] & target_buckets[CHANNEL] == BUCKET_I
                when should_write_bucket_pipeline {
                    bucket_write[BUCKET_I] = true
                    bucket_mux_from[BUCKET_I] = CHANNEL
                }
            }
        }
        for int BUCKET_I in 0..NUM_BUCKETS {
            when bucket_write[BUCKET_I] {
                int mux_from = bucket_mux_from[BUCKET_I]
                bucket_write_index[BUCKET_I] = target_indices_in_buckets[mux_from]
                bucket_write_value[BUCKET_I] = partial_sums[mux_from]
            }
        }

        
        // Grab the rightmost y value, using the assignment order trick. 
        int max_y_seen
        for int I in 0..PARALELLISM {
            when valids[I] {
                max_y_seen = y_indices[I]
            }
        }
        int next_highest_y
        when |valids & max_y_seen > highest_y {
            next_highest_y = max_y_seen
        } else {
            next_highest_y = highest_y
        }

        when end_of_y_block {
            current_front_buffer = current_front_buffer + 1 mod NUM_Y_BUFFERS
            // Delay y_end_value by 16 cycles, such that the last y writes have time to be committed before starting to read them again on the other side. 
            reg reg reg reg reg reg reg reg reg reg reg reg reg reg reg reg int y_end_value = next_highest_y
            y_ends_fifo.push(y_end_value)
            highest_y = 0
        } else {
            highest_y = next_highest_y mod NUM_Y_INDICES
        }
    }

    // Required to slowly reset the memory
    bool is_long_rst
    state int#(FROM: 0, TO: NUM_Y_BUFFERS * HALF_RAM_DEPTH) reset_rotator
    initial reset_rotator = 0

    state bool currently_outputting
    state int#(FROM: 0, TO: NUM_Y_INDICES + 1) num_ys_left_to_output
    state int#(FROM: 0, TO: HALF_RAM_DEPTH + 1)[NUM_BUCKETS] num_ys_left_per_bucket
    state int#(FROM: 0, TO: HALF_RAM_DEPTH)[NUM_BUCKETS] cur_output_y_per_bucket

    JoiningFIFO#(DEPTH: 32, NUM_FIFOS: NUM_BUCKETS) output_fifo
    output_fifo.pushes = RepeatGen#(T: type bool, V: false, SIZE: NUM_BUCKETS)
    for int BUCKET in 0..NUM_BUCKETS {
        RAM#(T: type double, DEPTH: HALF_RAM_DEPTH * NUM_Y_BUFFERS) bucket_ram
        when is_long_rst {
            bucket_ram.write(reset_rotator, 0.0d)
        } else when bucket_write[BUCKET] {
            reg int front_index = BitwiseIntConcat#(LOWER_BITS: clog2#(V: HALF_RAM_DEPTH))(current_front_buffer, bucket_write_index[BUCKET])
            reg double prev_value = bucket_ram.read(front_index)
            reg double new_value = fp64_add(prev_value, bucket_write_value[BUCKET])
            bucket_ram.write(front_index, new_value)
        } else when num_ys_left_per_bucket[BUCKET] != 0 & output_fifo.may_pushes[BUCKET] {
            reg int back_index = BitwiseIntConcat#(LOWER_BITS: clog2#(V: HALF_RAM_DEPTH))(current_back_buffer, cur_output_y_per_bucket[BUCKET])
            reg double read_value = bucket_ram.read(back_index)
            bucket_ram.write(back_index, 0.0d)
            reg output_fifo.datas[BUCKET] = fp64_to_fp32(read_value)
            reg output_fifo.pushes[BUCKET] = true
            cur_output_y_per_bucket[BUCKET] = cur_output_y_per_bucket[BUCKET] + 1 mod HALF_RAM_DEPTH
            num_ys_left_per_bucket[BUCKET] = num_ys_left_per_bucket[BUCKET] - 1 mod HALF_RAM_DEPTH
        }
    }

    when !currently_outputting {
        when y_ends_fifo.pop_available : int last_y_value {
            y_ends_fifo.pop()

            currently_outputting = true
            num_ys_left_to_output = last_y_value + 1
            for int BUCKET in 0..NUM_BUCKETS {
                num_ys_left_per_bucket[BUCKET] = (last_y_value / NUM_BUCKETS) + 1
                cur_output_y_per_bucket[BUCKET] = 0
            }
        }
    }

    domain y_returning
    input bool may_y_valid'0
    trigger y_valid'0 : float[16] output_y_values, int#(FROM: 0, TO: 17) num_y_valid, bool is_last_y
    
    when output_fifo.may_pop & may_y_valid {
        reg float[NUM_BUCKETS] floats_out = output_fifo.pop()
        when num_ys_left_to_output > NUM_BUCKETS {
            y_valid(floats_out, NUM_BUCKETS, false)
            num_ys_left_to_output = IntNarrow#(FROM: 0, TO: NUM_Y_INDICES)(num_ys_left_to_output - NUM_BUCKETS)
        } else {
            y_valid(floats_out, IntNarrow#(FROM: 0, TO: NUM_BUCKETS+1)(num_ys_left_to_output), true)
            currently_outputting = false
            current_back_buffer = current_back_buffer + 1 mod NUM_Y_BUFFERS
        }
    }

    domain reset
    action rst {
        current_front_buffer = 0
        current_back_buffer = 0
        highest_y = 0
        reset_rotator = reset_rotator + 1 mod HALF_RAM_DEPTH * NUM_Y_BUFFERS
        currently_outputting = false
        y_index_manager.rst()
        output_fifo.rst()
        y_ends_fifo.rst()
    }

    domain long_reset
    action long_rst {
        is_long_rst = true
    } else {
        is_long_rst = false
    }
}



module XVectorMemory {
    gen int PARALLELISM = 6
    gen int X_DEPTH = 1024
    gen int X_NUM_BUFFERS = 8
    gen int X_WRITE_SIZE = 16
    gen int RAM_DEPTH = X_DEPTH * X_NUM_BUFFERS

    state int#(FROM: 0, TO: X_NUM_BUFFERS) cur_reader_buffer
    state int#(FROM: 0, TO: X_NUM_BUFFERS) cur_writer_buffer

    domain reader
    // TODO Submodule Arrays (https://github.com/pc2/sus-compiler/issues/161)
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram1
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram2
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram3
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram4
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram5
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram6
    action multiply_bys : float[PARALLELISM] weights, int#(FROM: 0, TO: X_DEPTH)[PARALLELISM] x_indices, bool is_last -> float[PARALLELISM] terms {
        int[PARALLELISM] ram_idx
        for int I in 0..PARALLELISM {
            ram_idx[I] = BitwiseIntConcat#(LOWER_BITS: clog2#(V: X_DEPTH))(cur_reader_buffer, x_indices[I])
        }

        reg float[1][PARALLELISM] vector_values = [
            ram1.read(ram_idx[0]),
            ram2.read(ram_idx[1]),
            ram3.read(ram_idx[2]),
            ram4.read(ram_idx[3]),
            ram5.read(ram_idx[4]),
            ram6.read(ram_idx[5]),
        ]

        for int I in 0..PARALLELISM {
            terms[I] = fp32_mul(weights[I], vector_values[I][0])
        }

        when is_last {
            cur_reader_buffer = cur_reader_buffer + 1 mod X_NUM_BUFFERS
        }
    }

    domain writer
    state int#(FROM: 0, TO: X_DEPTH / X_WRITE_SIZE) cur_write_idx
    action write'0 : float[X_WRITE_SIZE] x_values'0, bool is_last_write'0 {
        int write_idx = BitwiseIntConcat#(LOWER_BITS: clog2#(V: X_DEPTH / X_WRITE_SIZE))(cur_writer_buffer, cur_write_idx)
        ram1.write(write_idx, x_values)
        ram2.write(write_idx, x_values)
        ram3.write(write_idx, x_values)
        ram4.write(write_idx, x_values)
        ram5.write(write_idx, x_values)
        ram6.write(write_idx, x_values)

        when is_last_write {
            cur_writer_buffer = cur_writer_buffer + 1 mod X_NUM_BUFFERS
            cur_write_idx = 0
        } else {
            cur_write_idx = cur_write_idx + 1 mod X_DEPTH / X_WRITE_SIZE
        }
    }

    domain reset
    action rst {
        cur_reader_buffer = 0
        cur_writer_buffer = 0
        cur_write_idx = 0
    }
}

module DecompressCommand {
    gen int X_DEPTH = 1 << 10
    gen int MAX_Y_STEP = 1 << 8
    action DecompressCommand :
        bool[256] bits ->
        float[6] weights,
        int#(FROM: 0, TO: X_DEPTH)[6] x_indices,
        int#(FROM: 0, TO: MAX_Y_STEP)[6] y_steps,
        bool last_in_x,
        bool last_in_y {

        int is_last_extra_mode = BitsToUInt(bits[252:256])

        bool is_5_float_mode = is_last_extra_mode == 15

        for int I in 0..6 {
            reg weights[I] = FromBits(bits[32 * I +: 32])

            if I == 5 {
                // In 5-float mode, so that we can reuse most of the wires, we 
                when is_5_float_mode {
                    reg weights[I] = 0.0
                }
            }
            // x_indices are indexed in reverse, such that 5-float mode creates a nice 
            x_indices[I] = BitsToUInt(bits[192 + (6 - 1 - I) * 10 +: 10])
        }

        when is_5_float_mode {
            // In 5-float mode, is_last values are purely 

            for int I in 0..5 {
                y_steps[I] = BitsToUInt(bits[160 + 8 * I +: 8])
            }
            y_steps[5] = 0 // No 6th float, so weight = 0.0 and no is_last

            last_in_x = bits[200]
            last_in_y = bits[201]
        } else {
            /// NOTE: The rightmost bit maps to the first float. 
            gen bool[6][15] EXTRA_IS_LAST_MAP = [
                6'b000000,
                6'b000001,
                6'b000010,
                6'b000100,
                6'b001000,
                6'b010000,
                6'b100000,
                6'b100001,
                6'b010001,
                6'b100010,
                6'b001001,
                6'b010010,
                6'b100100,
                6'b101000,
                6'b110000
            ]

            // In 6-float mode, is_last values are computed from a combination of the last 4 bits, and if ever an x index is lower than its predecessor. 
            bool[6] extra_is_lasts = EXTRA_IS_LAST_MAP[IntNarrow#(FROM: 0, TO: 15)(is_last_extra_mode)]

            bool[6] delta_is_lasts
            delta_is_lasts[5] = false
            // Some extra is_last information can be procured from the differences in the x indices. 
            for int I in 0..5 {
                delta_is_lasts[I] = x_indices[I + 1] <= x_indices[I]
            }

            for int I in 0..6 {
                when extra_is_lasts[I] | delta_is_lasts[I] {
                    y_steps[I] = 1
                } else {
                    y_steps[I] = 0
                }
            }

            last_in_x = false
            last_in_y = false
        }
    }
}

module DecompressXLastYLast {
    action DecompressXLastYLast: bool[256] compressed -> bool[2] last_xy {
        int mode = BitsToUInt(compressed[256:256])
        bool is_5float_mode = mode == 15
        when is_5float_mode {
            last_xy = [compressed[200], compressed[201]]
        } else {
            last_xy = [false, false]
        }
    }
}

/// The Semaphore is a construct for distributing a limited resource,
/// such as memory buffers or compute units. 
/// It has an internal counter called the "permits" counter which keeps track of
/// how many of the guarded resource have been given out thus far. 
/// 
/// With `may_acquire` and `acquire()`, you request a "permit" for a resource. 
/// You use the resource for a while, and when you're done with it, you return it with `release()`
/// 
/// For this mode of operation, you start the Semaphore out with `INITIAL_PERMITS=MAX` permits. 
/// 
/// You can also use the Semaphore in reverse mode, acting somewhat akin to a FIFO. 
/// In this case, the Semaphore should be set to `INITIAL_PERMITS=0`, and then when a compute job becomes available `release()` first
module Semaphore#(int MAX, int INITIAL_PERMITS) {
    domain write
    state int#(FROM: 0, TO: MAX+1) available_permits
    output bool may_acquire'0 = available_permits != 0
    int do_acquire = 0
    action acquire'0 {
        do_acquire = 1
    }

    domain read
    int do_release = 0
    action release'0 {
        do_release = 1
    }

    available_permits = IntNarrow#(FROM: 0, TO: MAX+1)(available_permits - do_acquire + do_release)

    domain reset
    action rst {
        available_permits = INITIAL_PERMITS
    }
}

module SpMVUnit {
    gen int MAY_PUSH_LATENCY = 200

    gen int MAX_X_BUFS = 8
    gen int MAX_Y_BUFS = 2

    XVectorMemory x_vector_memory
    MultiAccumulate accumulate
    YCollector collector
    // The reset lengthener is needed because YCollector needs at least 4096 cycles to fully initialize its memory to 0.0
    // It's here because we can't assume that the BSP will hold the reset for long enough
    ResetLengthener#(MIN_RESET_CYCLES: 4096) reset_lengthener
    FWFT#(DEPTH: 512, T: type bool[256]) packed_data_fifo

    domain main
    output bool may_push'-MAY_PUSH_LATENCY = packed_data_fifo.may_push
    action push'0: bool[256] packed_matrix_data'0 {
        packed_data_fifo.push(packed_matrix_data)
    }

    Semaphore#(MAX: MAX_X_BUFS, INITIAL_PERMITS: 0) num_x_bufs_in_use
    Semaphore#(MAX: MAX_Y_BUFS, INITIAL_PERMITS: MAX_Y_BUFS) num_y_bufs_in_use

    domain x_buffer_releases
    // Called when the last element of the x buffer has been used, to signal to the x vector producer more x elements may be sent. 
    output bool release_x_buffer = false

    when packed_data_fifo.pop_available : bool[256] packed_matrix_data {
        // We don't send any data down the pipeline as long as the reset_lengthener is still working. 
        // This way, we can already get HBM data into the FIFO, and load X vector data, but only start reading from the FIFO once the Y collector memory is cleared
        when num_x_bufs_in_use.may_acquire & num_y_bufs_in_use.may_acquire & !reset_lengthener.rst_out {
            packed_data_fifo.pop()
            float[6] weights, int[6] x_indices, int[6] y_deltas, bool end_of_x, bool end_of_y = DecompressCommand(packed_matrix_data)

            when end_of_x {
                num_x_bufs_in_use.acquire()
                release_x_buffer = true
            }
            when end_of_y {
                num_y_bufs_in_use.acquire()
            }

            float[6] terms = x_vector_memory.multiply_bys(weights, x_indices, end_of_x)

            double[6] high_precision_terms
            for int I in 0..6 {
                high_precision_terms[I] = fp32_to_fp64(terms[I])
            }

            bool[6] is_lasts
            for int I in 0..6 {
                is_lasts[I] = y_deltas[I] != 0
            }

            double[6] partial_sums = accumulate.valid_set(high_precision_terms, is_lasts)

            collector.push_partial_sums(partial_sums, y_deltas, end_of_x, end_of_y)
        }
    }

    domain x_vector_loading
    action write_x_values'0: float[16] x_values'0, bool is_last_write'0 {
        x_vector_memory.write(x_values, is_last_write)
        when is_last_write {
            num_x_bufs_in_use.release()
        }
    }

    /// To coordinate the y storage bursts, only a single SpMV unit may be outputting y values onto the shared bus at a time
    /// If the Unit receives a token from start_y_burst, it is allowed to push data onto the y_valid channel. 
    /// The token is returned when a y_valid transaction is given with is_last_y set. 
    domain y_bus_tokens
    state bool has_y_burst_token
    action start_y_burst'0 {
        has_y_burst_token = true
    }

    /// Serves as regular backpressure for y_valid. This is in contrast to start_y_burst, which is called once and grants
    /// the unit the right to push onto the y_valid channel. 
    /// start_y_burst and may_y_valid are separate, because doing so allows us to pipeline both signals freely,
    /// something that is quite important for the SLR crossing we'll be doing
    domain y_valid_channel
    input bool may_y_valid'0
    collector.may_y_valid = may_y_valid & has_y_burst_token
    trigger y_valid'0 : float[16] output_y_values, int#(FROM: 0, TO: 17) num_y_valid'0, bool is_last_y'0
    when collector.y_valid : float[16] output_y_values, int#(FROM: 0, TO: 17) num_y_valid, bool is_last_y {
        y_valid(output_y_values, num_y_valid, is_last_y)
        when is_last_y {
            has_y_burst_token = false
            num_y_bufs_in_use.release()
        }
    }

    domain reset
    action rst {
        has_y_burst_token = false
        x_vector_memory.rst()
        collector.rst()
        num_x_bufs_in_use.rst()
        num_y_bufs_in_use.rst()
        packed_data_fifo.rst()
        reset_lengthener.rst_in()
    }

    when reset_lengthener.rst_out {
        collector.long_rst()
        accumulate.rst() // Long reset for accumulate too, because the pipeline (~170 stages) is fairly long
    }
}
