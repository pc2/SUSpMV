
module MultiAccumulate {
    gen int PARALLELISM = 6

    fp64_reduce_sum accumulator

    domain default
    action valid_set : double[PARALLELISM] values, bool[PARALLELISM] is_lasts -> double[PARALLELISM] partial_sums {
        split double[PARALLELISM] adder_left_inputs
        split double[PARALLELISM] adder_outputs

        for int I in 0..6 {
            when is_lasts[I] {
                adder_left_inputs[I] = 0.0d
            } else {
                adder_left_inputs[I] = adder_outputs[I]
            }
        }

        adder_outputs[0] = values[0]
        for int I in 1..6 {
            adder_outputs[I] = fp64_add(adder_left_inputs[I-1], values[I])
        }

        double[PARALLELISM] accumulator_input_selector
        for int I in 0..6 {
            accumulator_input_selector[I] = adder_outputs[I]
        }

        FirstSetBit find_first_bit
        find_first_bit.find(is_lasts)
        when find_first_bit.is_nonzero : int index {
            accumulator.accumulate(accumulator_input_selector[index])
            double accululated_partial_sum = accumulator.last(accumulator_input_selector[PARALLELISM-1])

            for int I in 0..PARALLELISM {
                when index == I {
                    partial_sums[I] = accululated_partial_sum
                } else {
                    partial_sums[I] = adder_outputs[I]
                }
            }
        } else {
            accumulator.accumulate(accumulator_input_selector[PARALLELISM-1])
        }
    }

    domain reset
    action rst {
        accumulator.rst()
    }
}

module YIndexManager {
    gen int PARALELLISM = 6
    gen int Y_TO = 2048 * 16
    gen int Y_DELTA_TO = 256

    state int#(FROM: 0, TO: Y_TO) cur_y_base

    domain main
    action push :
        int#(FROM: 0, TO: Y_DELTA_TO)[PARALELLISM] y_deltas,
        bool is_last -> int[PARALELLISM] y_indices {
        
        split int[7] total_deltas
        total_deltas[0] = 0
        for int I in 0..6 {
            reg total_deltas[I+1] = total_deltas[I] + y_deltas[I]
        }
        for int I in 0..6 {
            reg y_indices[I] = cur_y_base + total_deltas[I] mod Y_TO
        }
        
        when is_last {
            cur_y_base = 0
        } else {
            cur_y_base = cur_y_base + total_deltas[6] mod Y_TO
        }
    }

    domain reset
    action rst {
        cur_y_base = 0
    }
}

/// Collects and sums up y values. 
/// reset must be held for 4096 cycles to fully reset the Y vector memory
module YCollector#(int REQUEST_Y_LATENCY) {
    //DoubleBuffer#(T: type double, DEPTH: 2048, NUM_BUFFERS: 2) buf
    gen int PARALELLISM = 6
    gen int NUM_BUCKETS = 16
    // The 16 banks are arranged as double buffers. 
    gen int HALF_RAM_DEPTH = 2048
    gen int Y_DELTA = 256
    YIndexManager y_index_manager

    state int#(FROM: 0, TO: 4) current_front_buffer
    state int#(FROM: 0, TO: 4) current_back_buffer

    bool[NUM_BUCKETS] bucket_write = RepeatGen#(T: type bool, V: false, SIZE: NUM_BUCKETS)
    double[NUM_BUCKETS] bucket_write_value
    int[NUM_BUCKETS] bucket_write_index
    int[NUM_BUCKETS] bucket_mux_from

    domain default
    action push_partial_sums'0 :
        double[PARALELLISM] partial_sums'0,
        int#(FROM: 0, TO: Y_DELTA)[PARALELLISM] y_deltas,
        bool end_of_x_block,
        bool full_end {

        when full_end {
            current_front_buffer = current_front_buffer + 1 mod 4
        }

        int[PARALELLISM] y_indices = y_index_manager.push(y_deltas, end_of_x_block)
        bool[PARALELLISM] valids
        for int I in 0..PARALELLISM {
            reg valids[I] = y_deltas[I] != 0
        }

        int[PARALELLISM] target_buckets
        int[PARALELLISM] target_indices_in_buckets

        for int CHANNEL in 0..PARALELLISM {
            target_buckets[CHANNEL] = y_indices[CHANNEL] mod NUM_BUCKETS
            target_indices_in_buckets[CHANNEL] = y_indices[CHANNEL] / NUM_BUCKETS
        }
        
        for int BUCKET_I in 0..NUM_BUCKETS {
            for int CHANNEL in 0..PARALELLISM {
                when valids[CHANNEL] & target_buckets[CHANNEL] == BUCKET_I {
                    bucket_write[BUCKET_I] = true
                    bucket_mux_from[BUCKET_I] = CHANNEL
                }
            }
        }
        for int BUCKET_I in 0..NUM_BUCKETS {
            when bucket_write[BUCKET_I] {
                int mux_from = bucket_mux_from[BUCKET_I]
                bucket_write_index[BUCKET_I] = target_indices_in_buckets[mux_from]
                bucket_write_value[BUCKET_I] = partial_sums[mux_from]
            }
        }
    }

    // Required to slowly reset the memory
    bool is_rst
    state int#(FROM: 0, TO: 2 * HALF_RAM_DEPTH) reset_rotator
    initial reset_rotator = 0

    // We can load a single Y value at a time. It's not supremely bandwidth-critical to get them out as fast as possible,
    // so we save on SLR crossings by muxing them together here
    state int#(FROM: 0, TO: NUM_BUCKETS) output_request_bucket
    state int#(FROM: 0, TO: HALF_RAM_DEPTH) output_request_idx
    state bool request_bucket_is_last
    state bool request_bucket_valid

    domain y_requests_taking
    Tuple2 pack_y_command
    FWFT#(DEPTH: nextPow2#(V: REQUEST_Y_LATENCY * 2)) y_output_request_fifo
    output bool may_request_y'-REQUEST_Y_LATENCY = y_output_request_fifo.may_push
    action request_y'0 : int#(FROM: 0, TO: HALF_RAM_DEPTH * NUM_BUCKETS) y_index'0, bool last'0 {
        y_output_request_fifo.push(pack_y_command.pack(y_index, last))
    }
    
    when !request_bucket_valid {
        when y_output_request_fifo.pop_available : bool[] packed_y_command {
            int index, bool last = pack_y_command.unpack(packed_y_command)
            output_request_bucket = index mod NUM_BUCKETS
            output_request_idx = index / NUM_BUCKETS
            request_bucket_is_last = last
            request_bucket_valid = true
            y_output_request_fifo.pop()
        }
    }

    domain y_taking
    bool is_getting_y
    action try_get_y {
        is_getting_y = true
    } else {
        is_getting_y = false
    }
    trigger y_valid : double y, bool last_y {
        request_bucket_valid = false
        when request_bucket_is_last {
            current_back_buffer = current_back_buffer + 1 mod 4
        }
    }
    
    bool may_be_outputting = current_back_buffer != current_front_buffer
    for int BUCKET in 0..NUM_BUCKETS {
        RAM#(DEPTH: HALF_RAM_DEPTH * 2) bucket_ram
        when is_rst {
            bucket_ram.write(reset_rotator, 0.0d)
        } else when bucket_write[BUCKET] {
            int front_index = BitwiseIntConcat#(LOWER_BITS: clog2#(V: HALF_RAM_DEPTH))(current_front_buffer mod 2, bucket_write_index[BUCKET])
            reg double prev_value = bucket_ram.read(front_index)
            double new_value = fp64_add(prev_value, bucket_write_value[BUCKET])
            bucket_ram.write(front_index, new_value)
        } else when may_be_outputting & output_request_bucket == BUCKET & request_bucket_valid & is_getting_y {
            int back_index = BitwiseIntConcat#(LOWER_BITS: clog2#(V: HALF_RAM_DEPTH))(current_back_buffer mod 2, output_request_idx)
            reg double read_value = bucket_ram.read(back_index)
            y_valid(read_value, request_bucket_is_last)
            bucket_ram.write(back_index, 0.0d)
        }
    }

    domain reset
    action rst {
        request_bucket_valid = false
        current_front_buffer = 0
        current_back_buffer = 0
        reset_rotator = reset_rotator + 1 mod 2 * HALF_RAM_DEPTH
        is_rst = true
        y_index_manager.rst()
        y_output_request_fifo.rst()
    } else {
        is_rst = false
    }
}



module XVectorMemory {
    gen int PARALLELISM = 6
    gen int X_DEPTH = 1024
    gen int X_NUM_BUFFERS = 8
    gen int X_WRITE_SIZE = 16
    gen int RAM_DEPTH = X_DEPTH * X_NUM_BUFFERS

    state int#(FROM: 0, TO: X_NUM_BUFFERS) cur_reader_buffer
    state int#(FROM: 0, TO: X_NUM_BUFFERS) cur_writer_buffer

    domain reader
    // TODO Submodule Arrays (https://github.com/pc2/sus-compiler/issues/161)
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram1
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram2
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram3
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram4
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram5
    RAM_Unbalanced#(DEPTH: RAM_DEPTH, READ_SIZE: 1, WRITE_SIZE: X_WRITE_SIZE) ram6
    action multiply_bys : float[PARALLELISM] weights, int#(FROM: 0, TO: X_DEPTH)[PARALLELISM] x_indices, bool is_last -> float[PARALLELISM] terms {
        int[PARALLELISM] ram_idx
        for int I in 0..PARALLELISM {
            ram_idx[I] = BitwiseIntConcat#(LOWER_BITS: clog2#(V: X_DEPTH))(cur_reader_buffer, x_indices[I])
        }

        float[1][PARALLELISM] vector_values = [
            ram1.read(ram_idx[0]),
            ram2.read(ram_idx[1]),
            ram3.read(ram_idx[2]),
            ram4.read(ram_idx[3]),
            ram5.read(ram_idx[4]),
            ram6.read(ram_idx[5]),
        ]

        for int I in 0..PARALLELISM {
            terms[I] = fp32_mul(weights[I], vector_values[I][0])
        }

        when is_last {
            cur_reader_buffer = cur_reader_buffer + 1 mod X_NUM_BUFFERS
        }
    }

    domain writer
    state int#(FROM: 0, TO: X_DEPTH / X_WRITE_SIZE) cur_write_idx
    action write'0 : float[X_WRITE_SIZE] x_values'0, bool is_last_write'0 {
        int write_idx = BitwiseIntConcat#(LOWER_BITS: clog2#(V: X_DEPTH / X_WRITE_SIZE))(cur_writer_buffer, cur_write_idx)
        ram1.write(write_idx, x_values)
        ram2.write(write_idx, x_values)
        ram3.write(write_idx, x_values)
        ram4.write(write_idx, x_values)
        ram5.write(write_idx, x_values)
        ram6.write(write_idx, x_values)

        when is_last_write {
            cur_writer_buffer = cur_writer_buffer + 1 mod X_NUM_BUFFERS
            cur_write_idx = 0
        } else {
            cur_write_idx = cur_write_idx + 1 mod X_DEPTH / X_WRITE_SIZE
        }
    }

    domain reset
    action rst {
        cur_reader_buffer = 0
        cur_writer_buffer = 0
        cur_write_idx = 0
    }
}

/// There are two possible formats:
/// ## 6 float (for dense sections)
/// ```
///   256 bit [
///     [  0:192] - 6 floats
///     [192:252] - 6 10-bit x indices in reverse order
///     [252:256] - is_last_extra bitset
///   ]
///   is_last_extra table:
///     4'b0000: 6'b000000
///     4'b0001: 6'b000001
///     4'b0010: 6'b000010
///     4'b0011: 6'b000100
///     4'b0100: 6'b001000
///     4'b0101: 6'b010000
///     4'b0110: 6'b100000
///     4'b0111: 6'b100001
///     4'b1000: 6'b010001
///     4'b1001: 6'b100010
///     4'b1010: 6'b001001
///     4'b1011: 6'b010010
///     4'b1100: 6'b100100
///     4'b1101: 6'b101000 // Some extra possibilities for a "last" first elem, because the deltas don't work to detect the first is_last. 
///     4'b1110: 6'b110000
///     4'b1111: Signifies 5 float mode
/// ```
/// Equivalent to:
/// ```c
/// struct Float6 {
///   float[6] weights;
///   uint64_t x_index_5 : 10;
///   uint64_t x_index_4 : 10;
///   uint64_t x_index_3 : 10;
///   uint64_t x_index_2 : 10;
///   uint64_t x_index_1 : 10;
///   uint64_t x_index_0 : 10;
///   uint64_t mode      : 4;
/// }
/// ```
/// ## 5 float (for sparse sections)
/// ```
///   256 bit [
///     [  0:160] - 5 floats
///     [160:200] - 5 8-bit y deltas
///     [200:202] - UNUSED
///     [202:252] - 5 10-bit x indices in reverse order
///     [252:256] - 4'b1111
///   ]
/// ```
/// Equivalent to:
/// ```c
/// struct Float5 {
///   float[5] weights;
///   uint8_t y_delta0;
///   uint8_t y_delta1;
///   uint8_t y_delta2;
///   uint8_t y_delta3;
///   uint64_t y_delta4  : 8;
///   uint64_t _UNUSED   : 2;
///   uint64_t x_index_4 : 10;
///   uint64_t x_index_3 : 10;
///   uint64_t x_index_2 : 10;
///   uint64_t x_index_1 : 10;
///   uint64_t x_index_0 : 10;
///   uint64_t mode      : 4; // == 4'b1111
/// }
/// ```
///
/// `y_steps != 0` means that it `is_last`
module DecompressCommand {
    gen int X_DEPTH = 1 << 10
    gen int MAX_Y_STEP = 1 << 8
    action DecompressCommand :
        bool[256] bits ->
        float[6] weights,
        int#(FROM: 0, TO: X_DEPTH)[6] x_indices,
        int#(FROM: 0, TO: MAX_Y_STEP)[6] y_steps {

        int is_last_extra_mode = BitsToUInt(bits[252:256])

        bool is_5_float_mode = is_last_extra_mode == 15

        for int I in 0..6 {
            reg weights[I] = FromBits(bits[32 * I +: 32])

            if I == 5 {
                // In 5-float mode, so that we can reuse most of the wires, we 
                when is_5_float_mode {
                    reg weights[I] = 0.0
                }
            }
            // x_indices are indexed in reverse, such that 5-float mode creates a nice 
            x_indices[I] = BitsToUInt(bits[192 + (6 - 1 - I) * 10 +: 10])
        }

        when is_5_float_mode {
            // In 5-float mode, is_last values are purely 

            for int I in 0..5 {
                y_steps[I] = BitsToUInt(bits[160 + 8 * I +: 8])
            }
            y_steps[5] = 0 // No 6th float, so weight = 0.0 and no is_last
        } else {
            gen bool[6][15] EXTRA_IS_LAST_MAP = [
                6'b000000,
                6'b000001,
                6'b000010,
                6'b000100,
                6'b001000,
                6'b010000,
                6'b100000,
                6'b100001,
                6'b010001,
                6'b100010,
                6'b001001,
                6'b010010,
                6'b100100,
                6'b101000,
                6'b110110
            ]

            // In 6-float mode, is_last values are computed from a combination of the last 4 bits, and if ever an x index is lower than its predecessor. 
            bool[6] extra_is_lasts = EXTRA_IS_LAST_MAP[IntNarrow#(FROM: 0, TO: 15)(is_last_extra_mode)]

            bool[6] delta_is_lasts
            delta_is_lasts[0] = false
            // Some extra is_last information can be procured from the differences in the x indices. 
            for int I in 1..6 {
                delta_is_lasts[I] = x_indices[I] <= x_indices[I - 1]
            }

            for int I in 0..6 {
                when extra_is_lasts[I] | delta_is_lasts[I] {
                    y_steps[I] = 1
                } else {
                    y_steps[I] = 0
                }
            }
        }
    }
}

module SpMVUnit {
    gen int REQUEST_Y_LATENCY = 5

    gen int MAX_NUM_YS = 2048 * 16 // HALF_RAM_DEPTH * NUM_BUCKETS

    XVectorMemory x_vector_memory
    MultiAccumulate accumulate
    YCollector#(REQUEST_Y_LATENCY) collector

    domain main
    action push'0: bool[256] packed_matrix_data'0, bool end_of_x_chunk'0, bool full_end'0 {
        float[6] weights, int[6] x_indices, int[6] y_deltas = DecompressCommand(packed_matrix_data)

        float[6] terms = x_vector_memory.multiply_bys(weights, x_indices, end_of_x_chunk)

        double[6] high_precision_terms
        for int I in 0..6 {
            high_precision_terms[I] = fp32_to_fp64(terms[I])
        }

        bool[6] is_lasts
        for int I in 0..6 {
            is_lasts[I] = y_deltas[I] != 0
        }

        double[6] partial_sums = accumulate.valid_set(high_precision_terms, is_lasts)

        collector.push_partial_sums(partial_sums, y_deltas, end_of_x_chunk, full_end)
    }

    domain x_vector_loading
    action write_x_values'0: float[16] x_values'0, bool is_last_write'0 {
        x_vector_memory.write(x_values, is_last_write)
    }

    domain y_requests_taking
    output bool may_request_y'-REQUEST_Y_LATENCY = collector.may_request_y
    action request_y'0 : int#(FROM: 0, TO: MAX_NUM_YS) y_index'0, bool is_last_y_req'0 {
        collector.request_y(y_index, is_last_y_req)
    }

    domain y_taking
    action try_get_y {
        collector.try_get_y()
    }
    trigger y_valid'0 : double y'0, bool last_y'0
    when collector.y_valid : double y, bool last_y {
        y_valid(y, last_y)
    }

    domain reset
    action rst {
        x_vector_memory.rst()
        accumulate.rst()
        collector.rst()
    }
}

/// OTHER FORMAT?
/// ## 6 float (for dense sections)
/// ```
///   256 bit [
///     [  0: 32] - weights[0]
///     [ 32: 42] - x_idx[0]
///     [ 42: 74] - weights[1]
///     [ 74: 84] - x_idx[1]
///     [ 84:116] - weights[2]
///     [116:126] - x_idx[2]
///     [126:158] - weights[3]
///     [158:168] - x_idx[3]
///     [168:200] - weights[4]
///     [200:210] - x_idx[4]
///     [210:242] - weights[5]
///     [242:252] - x_idx[5]
///     [252:256] - is_last_extra bitset
///   ]
///   is_last_extra table:
///     4'b0000: 6'b000000
///     4'b0001: 6'b000001
///     4'b0010: 6'b000010
///     4'b0011: 6'b000100
///     4'b0100: 6'b001000
///     4'b0101: 6'b010000
///     4'b0110: 6'b100000
///     4'b0111: 6'b100001
///     4'b1000: 6'b010001
///     4'b1001: 6'b100010
///     4'b1010: 6'b001001
///     4'b1011: 6'b010010
///     4'b1100: 6'b100100
///     4'b1101: UNUSED
///     4'b1110: UNUSED
///     4'b1111: Signifies 5 float mode
/// ```
/// ## 5 float (for sparse sections)
/// ```
///   256 bit [
///     [  0: 32] - weights[0]
///     [ 32: 42] - x_idx[0]
///     [ 42: 74] - weights[1]
///     [ 74: 84] - x_idx[1]
///     [ 84:116] - weights[2]
///     [116:126] - x_idx[2]
///     [126:158] - weights[3]
///     [158:168] - x_idx[3]
///     [168:200] - weights[4]
///     [200:210] - x_idx[4]
///     [210:218] - y_delta[0]
///     [218:226] - y_delta[1]
///     [226:234] - y_delta[2]
///     [234:242] - y_delta[3]
///     [242:250] - y_delta[4]
///     [250:252] - UNUSED
///     [252:256] - is_last_extra MUST BE 4'b1111
///   ]
/// ```