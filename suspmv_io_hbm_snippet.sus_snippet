    domain hbm{HBM_IDX}
    HBMReader#(START_REG: 0, ADDR_REG: HBM_ADDR_REGS[{HBM_IDX}], COUNT_REG: HBM_COUNT_REGS[{HBM_IDX}]) hbm{HBM_IDX}_reader
    output bool                                     maxi_hbm{HBM_IDX}_awvalid  = hbm{HBM_IDX}_reader.awvalid
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)   maxi_hbm{HBM_IDX}_awaddr   = hbm{HBM_IDX}_reader.awaddr
    output int#(FROM: 0, TO: 16)                    maxi_hbm{HBM_IDX}_awlen    = hbm{HBM_IDX}_reader.awlen
    output int#(FROM: 0, TO: 8)                     maxi_hbm{HBM_IDX}_awsize   = hbm{HBM_IDX}_reader.awsize
    output bool[2]                                  maxi_hbm{HBM_IDX}_awburst  = hbm{HBM_IDX}_reader.awburst
    output bool[3]                                  maxi_hbm{HBM_IDX}_awprot   = hbm{HBM_IDX}_reader.awprot
    output bool[4]                                  maxi_hbm{HBM_IDX}_awcache  = hbm{HBM_IDX}_reader.awcache
    output bool[2]                                  maxi_hbm{HBM_IDX}_awlock   = hbm{HBM_IDX}_reader.awlock
    output bool                                     maxi_hbm{HBM_IDX}_wvalid   = hbm{HBM_IDX}_reader.wvalid
    output bool[HBM_AXI_WIDTH]                      maxi_hbm{HBM_IDX}_wdata    = hbm{HBM_IDX}_reader.wdata
    output bool[HBM_AXI_WIDTH / 8]                  maxi_hbm{HBM_IDX}_wstrb    = hbm{HBM_IDX}_reader.wstrb
    output bool                                     maxi_hbm{HBM_IDX}_wlast    = hbm{HBM_IDX}_reader.wlast
    output bool                                     maxi_hbm{HBM_IDX}_bready   = hbm{HBM_IDX}_reader.bready
    input  bool                                     maxi_hbm{HBM_IDX}_wready
    input  bool                                     maxi_hbm{HBM_IDX}_bvalid
    input  bool[2]                                  maxi_hbm{HBM_IDX}_bresp
    input  bool                                     maxi_hbm{HBM_IDX}_awready
    hbm{HBM_IDX}_reader.awready =                          maxi_hbm{HBM_IDX}_awready
    hbm{HBM_IDX}_reader.wready =                           maxi_hbm{HBM_IDX}_wready
    hbm{HBM_IDX}_reader.bvalid =                           maxi_hbm{HBM_IDX}_bvalid
    hbm{HBM_IDX}_reader.bresp =                            maxi_hbm{HBM_IDX}_bresp
    output bool                                     maxi_hbm{HBM_IDX}_arvalid  = hbm{HBM_IDX}_reader.arvalid
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)   maxi_hbm{HBM_IDX}_araddr   = hbm{HBM_IDX}_reader.araddr
    output int#(FROM: 0, TO: 16)                    maxi_hbm{HBM_IDX}_arlen    = hbm{HBM_IDX}_reader.arlen
    output int#(FROM: 0, TO: 8)                     maxi_hbm{HBM_IDX}_arsize   = hbm{HBM_IDX}_reader.arsize
    output bool[2]                                  maxi_hbm{HBM_IDX}_arburst  = hbm{HBM_IDX}_reader.arburst
    output bool[3]                                  maxi_hbm{HBM_IDX}_arprot   = hbm{HBM_IDX}_reader.arprot
    output bool[4]                                  maxi_hbm{HBM_IDX}_arcache  = hbm{HBM_IDX}_reader.arcache
    output bool[2]                                  maxi_hbm{HBM_IDX}_arlock   = hbm{HBM_IDX}_reader.arlock
    output bool                                     maxi_hbm{HBM_IDX}_rready   = hbm{HBM_IDX}_reader.rready
    input  bool                                     maxi_hbm{HBM_IDX}_arready
    input  bool                                     maxi_hbm{HBM_IDX}_rvalid
    input  bool[HBM_AXI_WIDTH]                      maxi_hbm{HBM_IDX}_rdata
    input  bool[2]                                  maxi_hbm{HBM_IDX}_rresp
    input  bool                                     maxi_hbm{HBM_IDX}_rlast
    hbm{HBM_IDX}_reader.arready =                          maxi_hbm{HBM_IDX}_arready
    hbm{HBM_IDX}_reader.rvalid =                           maxi_hbm{HBM_IDX}_rvalid
    hbm{HBM_IDX}_reader.rdata =                            maxi_hbm{HBM_IDX}_rdata
    hbm{HBM_IDX}_reader.rresp =                            maxi_hbm{HBM_IDX}_rresp
    hbm{HBM_IDX}_reader.rlast =                            maxi_hbm{HBM_IDX}_rlast

    when hbm_ctrl_valid[{HBM_IDX}] {
        hbm{HBM_IDX}_reader.set_reg(hbm_ctrl_idx[{HBM_IDX}], hbm_ctrl_data[{HBM_IDX}])
    }
    hbm{HBM_IDX}_reader.ready_for_lots_of_data = hbm_may_pushes_hbm[{HBM_IDX}]
    when hbm{HBM_IDX}_reader.chunk_valid : bool[256] elements {
        hbm_weight_valids_hbm[{HBM_IDX}] = true
        hbm_weight_datas_hbm[{HBM_IDX}] = elements
    } else {
        hbm_weight_valids_hbm[{HBM_IDX}] = false
    }
    when hbm_rst_fanout.douts[{HBM_IDX}] {
        hbm{HBM_IDX}_reader.rst()
    }
