
module SharedAcquireSemaphore#(int MAX, int NUM_SEMAPHORES) {
    state int#(FROM: 0, TO: MAX+1)[NUM_SEMAPHORES] num_in_uses

    domain default
    input bool[NUM_SEMAPHORES] releases

    output bool may_acquire = true

    for int I in 0..NUM_SEMAPHORES {
        when num_in_uses[I] == MAX {
            may_acquire = false
        }
    }

    int acquire_all_inc = 0
    action acquire_all {
        acquire_all_inc = 1
    }

    for int I in 0..NUM_SEMAPHORES {
        num_in_uses[I] = IntNarrow#(FROM: 0, TO: MAX+1)(num_in_uses[I] + acquire_all_inc - BoolToInt(releases[I]))
    }

    domain reset
    action rst {
        for int I in 0..NUM_SEMAPHORES {
            num_in_uses[I] = 0
        }
    }
}

/// X vector data loader that keeps track of 
module XDataLoader#(int NUM_KERNELS) {
    gen int ADDR_WIDTH = 64
    gen int DDR_AXI_WIDTH = 512
    gen int MAX_PARALLEL_PAGES = 8
    gen int PAGE_PARALLEL_FLOATS = 16
    gen int TRANSFER_SIZE_BYTES = PAGE_PARALLEL_FLOATS * 4
    gen int PAGE_SIZE = 1024
    gen int NUM_PAGE_TRANSFERS = PAGE_SIZE / PAGE_PARALLEL_FLOATS

    axi_burst_reader#(ADDR_WIDTH, ADDR_ALIGN: DDR_AXI_WIDTH / 8, COUNT_TO: 1 << 32, MAX_IN_FLIGHT: 0) burst_reader

    domain hbm_read
    output bool                               arvalid'0 = burst_reader.arvalid
    input  bool                               arready'0
    output int#(FROM: 0, TO: 1 << ADDR_WIDTH) araddr'0 = burst_reader.araddr
    output int#(FROM: 0, TO: 256)             arlen'0 = burst_reader.arlen
    output int#(FROM: 0, TO: 8)               arsize'0  = burst_reader.arsize
    output bool[2]                            arburst'0 = burst_reader.arburst
    output bool[3]                            arprot'0 = burst_reader.arprot
    output bool[4]                            arcache'0 = burst_reader.arcache
    output int#(FROM: 0, TO: 16)              arqos'0 = burst_reader.arqos
    output bool                               arlock'0 = burst_reader.arlock
    output int#(FROM: 0, TO: 16)              arregion'0 = burst_reader.arregion
    input  bool                               rvalid'0
    output bool                               rready'0 = burst_reader.rready
    input  bool[DDR_AXI_WIDTH]                rdata'0
    input  bool[2]                            rresp'0
    input  bool                               rlast'0
    burst_reader.arready =                    arready
    burst_reader.rvalid =                     rvalid
    burst_reader.rdata =                      rdata
    burst_reader.rresp =                      rresp
    burst_reader.rlast =                      rlast

    state int#(FROM: 0, TO: 1 << ADDR_WIDTH) start_addr
    state int#(FROM: 0, TO: 1 << 32) num_x_pages
    state bool is_active
    SlowState#(T: type int#(FROM: 0, TO: 1 << ADDR_WIDTH)) cur_page_addr
    SlowState#(T: type int#(FROM: 0, TO: 1 << 32)) num_x_pages_remaining
    SlowState#(T: type int#(FROM: 0, TO: 1 << 32)) num_y_repeats_remaining

    domain control_loading
    action start_loading'0 : int#(FROM: 0, TO: 1 << ADDR_WIDTH) start_addr_in'0, int#(FROM: 0, TO: 1 << 32) num_pages_in'0, int#(FROM: 0, TO: 1 << 32) num_y_repeats'0 {
        start_addr = start_addr_in
        num_x_pages = num_pages_in
        cur_page_addr.set_fast(start_addr_in)
        num_x_pages_remaining.set_fast(num_pages_in)
        num_y_repeats_remaining.set_fast(num_y_repeats)
        is_active = true
    }

    domain x_page_releases_dom
    input bool[NUM_KERNELS] x_page_releases'0

    SharedAcquireSemaphore#(MAX: MAX_PARALLEL_PAGES, NUM_SEMAPHORES: NUM_KERNELS) x_load_control
    x_load_control.releases = x_page_releases

    domain x_data_channel
    burst_reader.ready_for_lots_of_data = true
    trigger x_valid'0 : float[PAGE_PARALLEL_FLOATS] x_values'0, bool x_last'0
    when burst_reader.chunk_valid : bool[DDR_AXI_WIDTH][1] elements, int _chunk_length, int _chunk_offset, bool x_last, bool[0] _extra {
        x_valid(FromBits(elements[0]), x_last)
    }

    when cur_page_addr.is_stable : int cur_addr {
        when num_x_pages_remaining.is_stable : int cur_x_remaining {
            when num_y_repeats_remaining.is_stable : int cur_y_repeats_remaining {
                when is_active & x_load_control.may_acquire & burst_reader.may_request_new_read & cur_x_remaining >= 1 {
                    burst_reader.request_new_read(cur_addr, NUM_PAGE_TRANSFERS, [])
                    x_load_control.acquire_all()
                    when cur_x_remaining == 1 {
                        when cur_y_repeats_remaining == 1 {
                            is_active = false
                        } else {
                            reg int next_y_repeats_remaining = cur_y_repeats_remaining - 1 mod 1 << 32
                            num_y_repeats_remaining.set_slow(next_y_repeats_remaining)
                        }
                        cur_page_addr.set_slow(start_addr)
                        num_x_pages_remaining.set_slow(num_x_pages)
                    } else {
                        cur_page_addr.set_slow(cur_addr + NUM_PAGE_TRANSFERS * TRANSFER_SIZE_BYTES mod 1 << 64)
                        reg int next_x_remaining = cur_x_remaining - 1 mod 1 << 32
                        num_x_pages_remaining.set_slow(next_x_remaining)
                    }
                }
            }
        }
    }

    domain reset
    action rst {
        x_load_control.rst()
        cur_page_addr.rst()
        burst_reader.rst()
        cur_page_addr.rst()
        num_x_pages_remaining.rst()
        num_y_repeats_remaining.rst()
        is_active = false
    }
}

