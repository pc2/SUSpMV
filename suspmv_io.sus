module YVectorWriter#(int NUM_KERNELS) {
    gen int DDR_AXI_WRITE_WIDTH = 512
    gen int MEM_ADDR_WIDTH = 64
    gen int MAY_PUSH_LATENCY = 200
    // ADDR_ALIGN of 4, because we want to get the float-size multiplexer
    axi_burst_writer#(ADDR_WIDTH: MEM_ADDR_WIDTH, ADDR_ALIGN: 4, ADDR_MAY_PUSH_LATENCY: 0, MAY_PUSH_LATENCY) writer

    domain ddr_write
    output bool                                    awvalid = writer.awvalid
    input  bool                                    awready
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)  awaddr = writer.awaddr
    output int#(FROM: 0, TO: 256)                  awlen = writer.awlen
    output int#(FROM: 0, TO: 8)                    awsize  = writer.awsize
    output bool[2]                                 awburst = writer.awburst
    output bool[3]                                 awprot = writer.awprot
    output bool[4]                                 awcache = writer.awcache
    output int#(FROM: 0, TO: 16)                   awqos = writer.awqos
    output bool                                    awlock = writer.awlock
    output int#(FROM: 0, TO: 16)                   awregion = writer.awregion
    output bool                                    wvalid = writer.wvalid
    input  bool                                    wready
    output bool[DDR_AXI_WRITE_WIDTH]               wdata = writer.wdata
    output bool[DDR_AXI_WRITE_WIDTH / 8]           wstrb = writer.wstrb
    output bool                                    wlast = writer.wlast
    input  bool                                    bvalid
    output bool                                    bready = writer.bready
    input  bool[2]                                 bresp
    writer.awready =                               awready
    writer.wready =                                wready
    writer.bvalid =                                bvalid
    writer.bresp =                                 bresp
    
    state int#(FROM: 0, TO: NUM_KERNELS) unit_holding_y_token
    state int#(FROM: 0, TO: 1 << 32) num_y_blocks_remaining

    domain y_start_tokens
    reg output bool[NUM_KERNELS] unit_may_starts = RepeatGen#(T: type bool, V: false, SIZE: NUM_KERNELS)

    domain start_write
    // There will only ever be one write here. Safe to ignore
    when writer.may_request_new_write {}
    action submit_y_vector_addr'0 : int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH) y_vec_addr'0, int#(FROM: 0, TO: 1 << 32) num_y_blocks'0 {
        writer.request_new_write(y_vec_addr)
        unit_holding_y_token = 0
        reg unit_may_starts[0] = true
        num_y_blocks_remaining = num_y_blocks - 1 mod 1 << 32
    }

    domain write_side
    output bool may_write'-MAY_PUSH_LATENCY = writer.may_write
    action write'-3 : float[16] y_values'0, int#(FROM: 0, TO: 17) num_y_values'0, bool last'0 {
        bool[32][16] write_elements
        
        for int I in 0..16 {
            write_elements[I] = ToBits(y_values[I])
        }
        bool write_is_true_last = false

        when last {
            int next_token_holding_unit = unit_holding_y_token + 1 mod NUM_KERNELS
            reg unit_may_starts[next_token_holding_unit] = true
            when unit_holding_y_token == NUM_KERNELS - 1 {
                when num_y_blocks_remaining == 0 {
                    // Overwrite unit_may_starts with false, since we're fully done
                    reg unit_may_starts = RepeatGen#(T: type bool, V: false, SIZE: NUM_KERNELS)
                    write_is_true_last = true
                } else {
                    num_y_blocks_remaining = num_y_blocks_remaining - 1 mod 1 << 32
                }
            }
            unit_holding_y_token = next_token_holding_unit
        }
        writer.write(write_elements, num_y_values, 0, write_is_true_last)
    }

    domain writing_finished_dom
    trigger write_has_been_committed
    when writer.write_has_been_committed {
        write_has_been_committed()
    }

    domain reset
    action rst {
        writer.rst()
    }
}

module LineBusMerge#(int SIZE) {
    gen int FROM = 0
    gen int TO = 17
    trigger out_valid: float[16] y_values_out, int#(FROM, TO) num_y_values_out, bool is_last_y_out

    input bool[SIZE] valids
    input float[16][SIZE] y_values
    input int#(FROM, TO)[SIZE] num_y_values
    input bool[SIZE] is_last_y
    
    split bool[SIZE] valids_regs
    split float[16][SIZE] y_values_line_regs
    split int#(FROM, TO)[SIZE] num_y_values_line_regs
    split bool[SIZE] is_last_y_line_regs

    valids_regs[0] = valids[0]
    y_values_line_regs[0] = y_values[0]
    num_y_values_line_regs[0] = num_y_values[0]
    is_last_y_line_regs[0] = is_last_y[0]
    for int I in 1..SIZE {
        bool valids_offset = LatencyOffset#(OFFSET: I-1)(valids[I])
        float[16] y_values_line_offset = LatencyOffset#(OFFSET: I-1)(y_values[I])
        int#(FROM, TO) num_y_values_line_offset = LatencyOffset#(OFFSET: I-1)(num_y_values[I])
        bool is_last_y_line_offset = LatencyOffset#(OFFSET: I-1)(is_last_y[I])
        when valids_offset {
            reg valids_regs[I] = true
            reg y_values_line_regs[I] = y_values_line_offset
            reg num_y_values_line_regs[I] = num_y_values_line_offset
            reg is_last_y_line_regs[I] = is_last_y_line_offset
        } else {
            reg valids_regs[I] = valids[I - 1]
            reg y_values_line_regs[I] = y_values[I - 1]
            reg num_y_values_line_regs[I] = num_y_values[I - 1]
            reg is_last_y_line_regs[I] = is_last_y[I - 1]
        }
    }

    if SIZE > 0 {
        when valids_regs[SIZE-1] {
            out_valid(y_values_line_regs[SIZE-1], num_y_values_line_regs[SIZE-1], is_last_y_line_regs[SIZE-1])
        }
    }
}

module SUSpMV_SLR#(int NUM_UNITS, int HBM_MAY_PUSH_LATENCY) {
    domain hbm_data
    output bool[NUM_UNITS] may_pushes'-HBM_MAY_PUSH_LATENCY
    input bool[NUM_UNITS] hbm_valids'0
    input bool[256][NUM_UNITS] hbm_datas'0

    domain x_data_dom
    bool is_pushing_x_data = false
    float[16] x_data
    bool last_x_data
    action push_x_data'0 : float[16] x_data_in'0, bool last_x_data_in'0 {
        is_pushing_x_data = true
        x_data = x_data_in
        last_x_data = last_x_data_in
    }
    
    domain x_data_releases
    output bool[NUM_UNITS] x_releases

    domain y_data_out
    LineBusMerge#(SIZE: NUM_UNITS) y_return_channel
    input bool may_y_valid
    trigger y_valid: float[16] y_values_out, int#(FROM: 0, TO: 17) num_y_values_out, bool is_last_y_out
    when y_return_channel.out_valid : float[16] y_values_out, int#(FROM: 0, TO: 17) num_y_values_out, bool is_last_y_out {
        y_valid(y_values_out, num_y_values_out, is_last_y_out)
    }

    domain y_starts
    input bool[NUM_UNITS] start_y_bursts
    
    domain reset
    bool is_rst = false
    action rst {
        is_rst = true
    }

    for int I in 0..NUM_UNITS {
        SpMVUnit unit

        // Matrix data
        reg may_pushes[I] = unit.may_push
        when hbm_valids[I] {
            unit.push(hbm_datas[I])
        }

        // X data
        when is_pushing_x_data {
            unit.write_x_values(x_data, last_x_data)
        }
        x_releases[I] = unit.release_x_buffer

        // Y data
        reg reg reg reg reg unit.may_y_valid = may_y_valid
        when unit.y_valid : float[16] output_y_values, int#(FROM: 0, TO: 17) num_y_valid, bool is_last_y {
            y_return_channel.valids[I] = true
            y_return_channel.y_values[I] = output_y_values
            y_return_channel.num_y_values[I] = num_y_valid
            y_return_channel.is_last_y[I] = is_last_y
        } else {
            y_return_channel.valids[I] = false
        }
        when start_y_bursts[I] {
            unit.start_y_burst()
        }

        when is_rst {
            unit.rst()
        }
    }
}

module SUSpMV_Full {
    clock aclk
    input bool aresetn

    gen int PARALLEL_X_READ = 16

    gen int CTRL_AXI_WIDTH = 64
    gen int CTRL_ADDR_WIDTH = 12

    gen int MEM_ADDR_WIDTH = 64
    gen int DDR_AXI_READ_WIDTH = PARALLEL_X_READ * 4 * 8
    gen int DDR_AXI_WRITE_WIDTH = 512
    gen int HBM_AXI_WIDTH = 256

    gen int NUM_HBMS = 2

    //xrt_ctrl_slave #(NUM_INPUT_REGS: 6 + 4 * NUM_HBMS, NUM_OUTPUT_REGS: 0, ADDR_WIDTH: CTRL_ADDR_WIDTH, AXI_WIDTH: CTRL_AXI_WIDTH) ctrl
    tapasco_ctrl_slave #(NUM_INPUT_REGS: 4 + 2 * NUM_HBMS, ADDR_WIDTH: CTRL_ADDR_WIDTH, AXI_WIDTH: CTRL_AXI_WIDTH) ctrl

    // ============================= //
    //  AXI4-Lite Control interface  //
    // ============================= //
    domain axi_control
    input  int#(FROM: 0, TO: 1 << CTRL_ADDR_WIDTH)    s_axi_control_awaddr
    input  bool                                       s_axi_control_awvalid
    output bool                                       s_axi_control_awready = ctrl.awready
    input bool[3]                                     s_axi_control_awprot
    input  bool[CTRL_AXI_WIDTH]                       s_axi_control_wdata
    input  bool[CTRL_AXI_WIDTH / 8]                   s_axi_control_wstrb
    input  bool                                       s_axi_control_wvalid
    output bool                                       s_axi_control_wready  = ctrl.wready
    output bool[2]                                    s_axi_control_bresp   = ctrl.bresp
    output bool                                       s_axi_control_bvalid  = ctrl.bvalid
    input  bool                                       s_axi_control_bready
    input  int#(FROM: 0, TO: 1 << CTRL_ADDR_WIDTH)    s_axi_control_araddr
    input  bool                                       s_axi_control_arvalid
    output bool                                       s_axi_control_arready = ctrl.arready
    input bool[3]                                     s_axi_control_arprot
    output bool[CTRL_AXI_WIDTH]                       s_axi_control_rdata   = ctrl.rdata
    output bool[2]                                    s_axi_control_rresp   = ctrl.rresp
    output bool                                       s_axi_control_rvalid  = ctrl.rvalid
    input  bool                                       s_axi_control_rready
    ctrl.awaddr  =                                    s_axi_control_awaddr
    ctrl.awvalid =                                    s_axi_control_awvalid
    ctrl.awprot  =                                    s_axi_control_awprot
    ctrl.wdata   =                                    s_axi_control_wdata
    ctrl.wstrb   =                                    s_axi_control_wstrb
    ctrl.wvalid  =                                    s_axi_control_wvalid
    ctrl.bready  =                                    s_axi_control_bready
    ctrl.araddr  =                                    s_axi_control_araddr
    ctrl.arvalid =                                    s_axi_control_arvalid
    ctrl.arprot  =                                    s_axi_control_arprot
    ctrl.rready  =                                    s_axi_control_rready
    output bool intr = ctrl.intr

    // ======================================================== //
    //  AXI4-Full DDR interface for X vector & result Y vector  //
    // ======================================================== //
    XDataLoader#(NUM_KERNELS: NUM_HBMS) x_vector_reader
    YVectorWriter#(NUM_KERNELS: NUM_HBMS) y_result_writer

    domain ddr_write
    output bool                                    maxi_ddr00_awvalid = y_result_writer.awvalid
    input  bool                                    maxi_ddr00_awready
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)  maxi_ddr00_awaddr = y_result_writer.awaddr
    output int#(FROM: 0, TO: 256)                  maxi_ddr00_awlen = y_result_writer.awlen
    output int#(FROM: 0, TO: 8)                    maxi_ddr00_awsize  = y_result_writer.awsize
    output bool[2]                                 maxi_ddr00_awburst = y_result_writer.awburst
    output bool[3]                                 maxi_ddr00_awprot = y_result_writer.awprot
    output bool[4]                                 maxi_ddr00_awcache = y_result_writer.awcache
    output int#(FROM: 0, TO: 16)                   maxi_ddr00_awqos = y_result_writer.awqos
    output bool                                    maxi_ddr00_awlock = y_result_writer.awlock
    output int#(FROM: 0, TO: 16)                   maxi_ddr00_awregion = y_result_writer.awregion
    output bool                                    maxi_ddr00_wvalid = y_result_writer.wvalid
    input  bool                                    maxi_ddr00_wready
    output bool[DDR_AXI_WRITE_WIDTH]               maxi_ddr00_wdata = y_result_writer.wdata
    output bool[DDR_AXI_WRITE_WIDTH / 8]           maxi_ddr00_wstrb = y_result_writer.wstrb
    output bool                                    maxi_ddr00_wlast = y_result_writer.wlast
    input  bool                                    maxi_ddr00_bvalid
    output bool                                    maxi_ddr00_bready = y_result_writer.bready
    input  bool[2]                                 maxi_ddr00_bresp
    y_result_writer.awready =                      maxi_ddr00_awready
    y_result_writer.wready =                       maxi_ddr00_wready
    y_result_writer.bvalid =                       maxi_ddr00_bvalid
    y_result_writer.bresp =                        maxi_ddr00_bresp
    
    domain ddr_read
    output bool                                    maxi_ddr00_arvalid'0 = x_vector_reader.arvalid
    input  bool                                    maxi_ddr00_arready
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)  maxi_ddr00_araddr = x_vector_reader.araddr
    output int#(FROM: 0, TO: 256)                  maxi_ddr00_arlen = x_vector_reader.arlen
    output int#(FROM: 0, TO: 8)                    maxi_ddr00_arsize  = x_vector_reader.arsize
    output bool[2]                                 maxi_ddr00_arburst = x_vector_reader.arburst
    output bool[3]                                 maxi_ddr00_arprot = x_vector_reader.arprot
    output bool[4]                                 maxi_ddr00_arcache = x_vector_reader.arcache
    output int#(FROM: 0, TO: 16)                   maxi_ddr00_arqos = x_vector_reader.arqos
    output bool                                    maxi_ddr00_arlock = x_vector_reader.arlock
    output int#(FROM: 0, TO: 16)                   maxi_ddr00_arregion = x_vector_reader.arregion
    input  bool                                    maxi_ddr00_rvalid
    output bool                                    maxi_ddr00_rready = x_vector_reader.rready
    input  bool[DDR_AXI_READ_WIDTH]                maxi_ddr00_rdata
    input  bool[2]                                 maxi_ddr00_rresp
    input  bool                                    maxi_ddr00_rlast
    x_vector_reader.arready =                      maxi_ddr00_arready
    x_vector_reader.rvalid =                       maxi_ddr00_rvalid
    x_vector_reader.rdata =                        maxi_ddr00_rdata
    x_vector_reader.rresp =                        maxi_ddr00_rresp
    x_vector_reader.rlast =                        maxi_ddr00_rlast


    // ===================================================== //
    //  AXI4-Full HBM Reader for the Sparse Matrix Elements  //
    // ===================================================== //

    domain hbm0
    axi_burst_reader#(MAX_IN_FLIGHT: 192, ADDR_WIDTH: 64, ADDR_ALIGN: 32) hbm00_reader
    axi_writer_tie_off#(ADDR_WIDTH: MEM_ADDR_WIDTH) hbm00_writer_tie_off
    output bool                                     maxi_hbm00_awvalid  = hbm00_writer_tie_off.awvalid
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)   maxi_hbm00_awaddr   = hbm00_writer_tie_off.awaddr
    output int#(FROM: 0, TO: 256)                   maxi_hbm00_awlen    = hbm00_writer_tie_off.awlen
    output int#(FROM: 0, TO: 8)                     maxi_hbm00_awsize   = hbm00_writer_tie_off.awsize
    output bool[2]                                  maxi_hbm00_awburst  = hbm00_writer_tie_off.awburst
    output bool[3]                                  maxi_hbm00_awprot   = hbm00_writer_tie_off.awprot
    output bool[4]                                  maxi_hbm00_awcache  = hbm00_writer_tie_off.awcache
    output int#(FROM: 0, TO: 16)                    maxi_hbm00_awqos    = hbm00_writer_tie_off.awqos
    output bool                                     maxi_hbm00_awlock   = hbm00_writer_tie_off.awlock
    output int#(FROM: 0, TO: 16)                    maxi_hbm00_awregion = hbm00_writer_tie_off.awregion
    output bool                                     maxi_hbm00_wvalid   = hbm00_writer_tie_off.wvalid
    output bool[HBM_AXI_WIDTH]                      maxi_hbm00_wdata    = hbm00_writer_tie_off.wdata
    output bool[HBM_AXI_WIDTH / 8]                  maxi_hbm00_wstrb    = hbm00_writer_tie_off.wstrb
    output bool                                     maxi_hbm00_wlast    = hbm00_writer_tie_off.wlast
    output bool                                     maxi_hbm00_bready   = hbm00_writer_tie_off.bready
    input  bool                                     maxi_hbm00_wready'0
    input  bool                                     maxi_hbm00_bvalid
    input  bool[2]                                  maxi_hbm00_bresp
    input  bool                                     maxi_hbm00_awready
    hbm00_writer_tie_off.awready =                  maxi_hbm00_awready
    hbm00_writer_tie_off.wready =                   maxi_hbm00_wready
    hbm00_writer_tie_off.bvalid =                   maxi_hbm00_bvalid
    hbm00_writer_tie_off.bresp =                    maxi_hbm00_bresp
    output bool                                     maxi_hbm00_arvalid  = hbm00_reader.arvalid
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)   maxi_hbm00_araddr   = hbm00_reader.araddr
    output int#(FROM: 0, TO: 256)                   maxi_hbm00_arlen    = hbm00_reader.arlen
    output int#(FROM: 0, TO: 8)                     maxi_hbm00_arsize   = hbm00_reader.arsize
    output bool[2]                                  maxi_hbm00_arburst  = hbm00_reader.arburst
    output bool[3]                                  maxi_hbm00_arprot   = hbm00_reader.arprot
    output bool[4]                                  maxi_hbm00_arcache  = hbm00_reader.arcache
    output int#(FROM: 0, TO: 16)                    maxi_hbm00_arqos    = hbm00_reader.arqos
    output bool                                     maxi_hbm00_arlock   = hbm00_reader.arlock
    output int#(FROM: 0, TO: 16)                    maxi_hbm00_arregion = hbm00_reader.arregion
    output bool                                     maxi_hbm00_rready   = hbm00_reader.rready
    input  bool                                     maxi_hbm00_arready'0
    input  bool                                     maxi_hbm00_rvalid
    input  bool[HBM_AXI_WIDTH]                      maxi_hbm00_rdata
    input  bool[2]                                  maxi_hbm00_rresp
    input  bool                                     maxi_hbm00_rlast
    hbm00_reader.arready =                          maxi_hbm00_arready
    hbm00_reader.rvalid =                           maxi_hbm00_rvalid
    hbm00_reader.rdata =                            maxi_hbm00_rdata
    hbm00_reader.rresp =                            maxi_hbm00_rresp
    hbm00_reader.rlast =                            maxi_hbm00_rlast


    domain hbm1
    axi_burst_reader#(MAX_IN_FLIGHT: 192, ADDR_WIDTH: 64, ADDR_ALIGN: 32) hbm01_reader
    axi_writer_tie_off#(ADDR_WIDTH: MEM_ADDR_WIDTH) hbm01_writer_tie_off
    output bool                                     maxi_hbm01_awvalid  = hbm01_writer_tie_off.awvalid
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)   maxi_hbm01_awaddr   = hbm01_writer_tie_off.awaddr
    output int#(FROM: 0, TO: 256)                   maxi_hbm01_awlen    = hbm01_writer_tie_off.awlen
    output int#(FROM: 0, TO: 8)                     maxi_hbm01_awsize   = hbm01_writer_tie_off.awsize
    output bool[2]                                  maxi_hbm01_awburst  = hbm01_writer_tie_off.awburst
    output bool[3]                                  maxi_hbm01_awprot   = hbm01_writer_tie_off.awprot
    output bool[4]                                  maxi_hbm01_awcache  = hbm01_writer_tie_off.awcache
    output int#(FROM: 0, TO: 16)                    maxi_hbm01_awqos    = hbm01_writer_tie_off.awqos
    output bool                                     maxi_hbm01_awlock   = hbm01_writer_tie_off.awlock
    output int#(FROM: 0, TO: 16)                    maxi_hbm01_awregion = hbm01_writer_tie_off.awregion
    output bool                                     maxi_hbm01_wvalid   = hbm01_writer_tie_off.wvalid
    output bool[HBM_AXI_WIDTH]                      maxi_hbm01_wdata    = hbm01_writer_tie_off.wdata
    output bool[HBM_AXI_WIDTH / 8]                  maxi_hbm01_wstrb    = hbm01_writer_tie_off.wstrb
    output bool                                     maxi_hbm01_wlast    = hbm01_writer_tie_off.wlast
    output bool                                     maxi_hbm01_bready   = hbm01_writer_tie_off.bready
    input  bool                                     maxi_hbm01_wready'0
    input  bool                                     maxi_hbm01_bvalid
    input  bool[2]                                  maxi_hbm01_bresp
    input  bool                                     maxi_hbm01_awready
    hbm01_writer_tie_off.awready =                  maxi_hbm01_awready
    hbm01_writer_tie_off.wready =                   maxi_hbm01_wready
    hbm01_writer_tie_off.bvalid =                   maxi_hbm01_bvalid
    hbm01_writer_tie_off.bresp =                    maxi_hbm01_bresp
    output bool                                     maxi_hbm01_arvalid  = hbm01_reader.arvalid
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)   maxi_hbm01_araddr   = hbm01_reader.araddr
    output int#(FROM: 0, TO: 256)                   maxi_hbm01_arlen    = hbm01_reader.arlen
    output int#(FROM: 0, TO: 8)                     maxi_hbm01_arsize   = hbm01_reader.arsize
    output bool[2]                                  maxi_hbm01_arburst  = hbm01_reader.arburst
    output bool[3]                                  maxi_hbm01_arprot   = hbm01_reader.arprot
    output bool[4]                                  maxi_hbm01_arcache  = hbm01_reader.arcache
    output int#(FROM: 0, TO: 16)                    maxi_hbm01_arqos    = hbm01_reader.arqos
    output bool                                     maxi_hbm01_arlock   = hbm01_reader.arlock
    output int#(FROM: 0, TO: 16)                    maxi_hbm01_arregion = hbm01_reader.arregion
    output bool                                     maxi_hbm01_rready   = hbm01_reader.rready
    input  bool                                     maxi_hbm01_arready'0
    input  bool                                     maxi_hbm01_rvalid
    input  bool[HBM_AXI_WIDTH]                      maxi_hbm01_rdata
    input  bool[2]                                  maxi_hbm01_rresp
    input  bool                                     maxi_hbm01_rlast
    hbm01_reader.arready =                          maxi_hbm01_arready
    hbm01_reader.rvalid =                           maxi_hbm01_rvalid
    hbm01_reader.rdata =                            maxi_hbm01_rdata
    hbm01_reader.rresp =                            maxi_hbm01_rresp
    hbm01_reader.rlast =                            maxi_hbm01_rlast

    // ========= //
    //  Kernels  //
    // ========= //
    SUSpMV_SLR#(NUM_UNITS: NUM_HBMS) suspmv_slr2

    // =========== //
    //  Addresses  //
    // =========== //

    // Pipeline regs to get from SLR0 to SLR1
    Tuple4 pack_ddr1_settings
    action_autopipeline pipe_to_ddr1
    
    Tuple2 pack_hbm_settings
    action_autopipeline pipe_to_hbms
    
    bool _hbm0_reader_may_request = hbm00_reader.may_request_new_read
    bool _hbm1_reader_may_request = hbm01_reader.may_request_new_read
    when ctrl.start {
        int x_vector_addr = BitsToUInt(ctrl.input_regs[0])
        int y_vector_addr = BitsToUInt(ctrl.input_regs[1])
        int num_x_pages = BitsToUInt(ctrl.input_regs[2]) mod 1 << 32
        int num_y_repetitions = BitsToUInt(ctrl.input_regs[3]) mod 1 << 32
        pipe_to_ddr1.din(pack_ddr1_settings.pack(x_vector_addr, y_vector_addr, num_x_pages, num_y_repetitions))

        int[NUM_HBMS] matrix_data_start_addrs
        int[NUM_HBMS] matrix_data_element_counts
        for int HBM_I in 0..NUM_HBMS {
            // Pipeline regs to reach both ends of SLR0
            matrix_data_start_addrs[HBM_I] = BitsToUInt(ctrl.input_regs[4 + HBM_I * 2])
            matrix_data_element_counts[HBM_I] = BitsToUInt(ctrl.input_regs[5 + HBM_I * 2]) mod 1 << 32
        }

        pipe_to_hbms.din(pack_hbm_settings.pack(matrix_data_start_addrs, matrix_data_element_counts))
    }
    when pipe_to_ddr1.dout : bool[] packed_ddr1_settings {
        int x_vector_addr,
        int y_vector_addr,
        int num_x_pages,
        int num_y_repetitions = pack_ddr1_settings.unpack(packed_ddr1_settings)

        x_vector_reader.start_loading(x_vector_addr, num_x_pages, num_y_repetitions)
        y_result_writer.submit_y_vector_addr(y_vector_addr, num_y_repetitions)
    }

    when pipe_to_hbms.dout : bool[] packed_hbm_settings {
        int[NUM_HBMS] matrix_data_start_addrs,
        int[NUM_HBMS] matrix_data_element_counts = pack_hbm_settings.unpack(packed_hbm_settings)

        hbm00_reader.request_new_read(matrix_data_start_addrs[0], matrix_data_element_counts[0], [])
        hbm01_reader.request_new_read(matrix_data_start_addrs[1], matrix_data_element_counts[1], [])
    }
    
    when y_result_writer.write_has_been_committed {
        ctrl.finish(64'b0)
    }

    // Shared data for SLRs
    // To cross SLR1 -> SLR2
    Tuple2 pack_x_vector_info_slr2
    action_autopipeline pipe_x_vector_info_slr2
    data_autopipeline pipe_x_page_releases_slr2

    pipe_x_page_releases_slr2.din = suspmv_slr2.x_releases
    x_vector_reader.x_page_releases[0:NUM_HBMS] = pipe_x_page_releases_slr2.dout

    when x_vector_reader.x_valid : float[16] x_values, bool x_last {
        pipe_x_vector_info_slr2.din(pack_x_vector_info_slr2.pack(x_values, x_last))
    }
    when pipe_x_vector_info_slr2.dout : bool[] packed {
        float[16] x_values, bool x_last = pack_x_vector_info_slr2.unpack(packed)
        suspmv_slr2.push_x_data(x_values, x_last)
    }

    // To cross SLR1 -> SLR2
    Tuple3 pack_y_valid_slr2
    action_autopipeline pipe_y_valid_slr2

    data_autopipeline pipe_start_y_bursts_slr2
    data_autopipeline pipe_may_y_valid_slr2

    pipe_start_y_bursts_slr2.din = y_result_writer.unit_may_starts[0:NUM_HBMS]
    suspmv_slr2.start_y_bursts = pipe_start_y_bursts_slr2.dout

    pipe_may_y_valid_slr2.din = y_result_writer.may_write
    suspmv_slr2.may_y_valid = pipe_may_y_valid_slr2.dout

    when suspmv_slr2.y_valid : float[16] y_values_out, int#(FROM: 0, TO: 17) num_y_values_out, bool is_last_y_out {
        pipe_y_valid_slr2.din(pack_y_valid_slr2.pack(y_values_out, num_y_values_out, is_last_y_out))
    }

    when pipe_y_valid_slr2.dout : bool[] packed {
        float[16] y_values_out, int#(FROM: 0, TO: 17) num_y_values_out, bool is_last_y_out = pack_y_valid_slr2.unpack(packed)
        y_result_writer.write(y_values_out, num_y_values_out, is_last_y_out)
    }

    // Connect all HBMs
    data_autopipeline pipe_may_push_hbm00
    pipe_may_push_hbm00.din = suspmv_slr2.may_pushes[0]
    hbm00_reader.ready_for_lots_of_data = pipe_may_push_hbm00.dout
    action_autopipeline pipe_weights_hbm00
    when hbm00_reader.chunk_valid : bool[256][1] elements, int _chunk_length, int _chunk_offset, bool _last, bool[0] _extra_data_out {
        pipe_weights_hbm00.din(elements[0])
    }
    when pipe_weights_hbm00.dout : bool[256] hbm_data {
        suspmv_slr2.hbm_valids[0] = true
        suspmv_slr2.hbm_datas[0] = hbm_data
    } else {
        suspmv_slr2.hbm_valids[0] = false
    }

    data_autopipeline pipe_may_push_hbm01
    pipe_may_push_hbm01.din = suspmv_slr2.may_pushes[1]
    hbm01_reader.ready_for_lots_of_data = pipe_may_push_hbm01.dout
    action_autopipeline pipe_weights_hbm01
    when hbm01_reader.chunk_valid : bool[256][1] elements, int _chunk_length, int _chunk_offset, bool _last, bool[0] _extra_data_out {
        pipe_weights_hbm01.din(elements[0])
    }
    when pipe_weights_hbm01.dout : bool[256] hbm_data {
        suspmv_slr2.hbm_valids[1] = true
        suspmv_slr2.hbm_datas[1] = hbm_data
    } else {
        suspmv_slr2.hbm_valids[1] = false
    }


    when !aresetn {
        ctrl.rst()
        x_vector_reader.rst()
        y_result_writer.rst()

        suspmv_slr2.rst()

        hbm00_reader.rst()
        hbm00_writer_tie_off.rst()
        hbm01_reader.rst()
        hbm01_writer_tie_off.rst()
    }
}
